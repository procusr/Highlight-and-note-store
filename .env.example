# ============================================
# MH-Go Environment Configuration Template
# ============================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control

# ============================================
# Application Configuration
# ============================================
PORT=8080
ENVIRONMENT=production

# ============================================
# Database Configuration
# ============================================
# For local development (Docker Compose uses internal DNS)
# DATABASE_URL=postgres://user:password@localhost:5433/mhgo?sslmode=disable

# For production with Docker Compose (container-to-container communication)
DATABASE_URL=postgres://user:password@postgres:5432/mhgo?sslmode=disable

# For production with external database (replace with your actual database URL)
# DATABASE_URL=postgres://username:password@your-db-host:5432/dbname?sslmode=require

# ============================================
# JWT Configuration
# ============================================
# CRITICAL: Change this to a strong random secret in production!
# Generate with: openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# ============================================
# Email Configuration (Optional)
# ============================================
# Required for password reset functionality
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
FROM_EMAIL=noreply@mh-go.com

# ============================================
# OpenAI Configuration (Optional)
# ============================================
# Required for AI-powered learning features
OPENAI_API_KEY=your-openai-api-key-here

# ============================================
# Production Security Notes
# ============================================
# 1. Generate a strong JWT_SECRET: openssl rand -base64 32
# 2. Use SSL/TLS for database connections (sslmode=require)
# 3. Store secrets in a secure vault (AWS Secrets Manager, HashiCorp Vault, etc.)
# 4. Use environment-specific .env files (.env.production, .env.staging)
# 5. Never expose internal ports directly in production (use reverse proxy)
