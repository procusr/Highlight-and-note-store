package templates

import "mh-go/internal/models"

// Learning Platform Page - Refactored with modular components
templ LearningPlatformPage(
	user *models.User,
	stats *models.DashboardStats,
	pathwayCards []models.LearningPathwayCard,
	topics []models.Topic,
	sessions []models.LearningSession,
	preferences *models.UserPreferences,
) {
	@Layout("Learn") {
		@Sidebar("learning", user)

		<main class="pt-16 md:pt-6 pb-6">
			<div class="main-container" x-data="{
				showModal: false,
				step: 1,
				topic: '',
				goal: '',
				selectedMethod: ''
			}">
				@PlatformHeader()
				@ActiveLearningSessionsSection(sessions)
				@LearningPathsSection(pathwayCards, len(sessions) > 0)

				@NewLearningSessionModal()
				@DeleteLearningSessionModal()
				<div id="learning-result"></div>
			</div>
		</main>

		<script>
			// Modal control functions
			document.addEventListener('DOMContentLoaded', function() {
				// Show delete session modal
				window.showDeleteSessionModal = (sessionId, sessionName) => {
					const modal = document.getElementById('deleteSessionModal');
					const sessionNameElement = document.getElementById('sessionNameToDelete');
					const confirmButton = document.getElementById('confirmDeleteSession');

					if (sessionNameElement) {
						sessionNameElement.textContent = sessionName;
					}

					if (confirmButton) {
						// Remove old event listeners by cloning
						const newButton = confirmButton.cloneNode(true);
						confirmButton.parentNode.replaceChild(newButton, confirmButton);

						// Add new event listener
						newButton.addEventListener('click', () => {
							fetch(`/api/learning/sessions/${sessionId}`, {
								method: 'DELETE',
								headers: {
									'Content-Type': 'application/json',
								}
							})
							.then(response => {
								if (response.ok) {
									// Remove the session card from DOM
									const sessionCard = document.querySelector(`[data-session-id="${sessionId}"]`);
									if (sessionCard) {
										sessionCard.remove();
									}

									// Close modal
									modal.classList.add('hidden');

									// Show success message
									showNotification('Learning session deleted successfully', 'success');

									// Refresh the page after a short delay to update the UI
									setTimeout(() => {
										window.location.reload();
									}, 1000);
								} else {
									showNotification('Failed to delete session', 'error');
								}
							})
							.catch(error => {
								console.error('Error deleting session:', error);
								showNotification('Error deleting session', 'error');
							});
						});
					}

					// Show modal
					modal.classList.remove('hidden');
				};

				// Close delete modal
				window.closeDeleteSessionModal = () => {
					const modal = document.getElementById('deleteSessionModal');
					modal.classList.add('hidden');
				};

				// Simple notification system
				window.showNotification = (message, type = 'info') => {
					const notification = document.createElement('div');
					notification.className = `fixed top-4 right-4 px-4 py-2 rounded-md text-white z-50 ${
						type === 'success' ? 'bg-green-500' : 
						type === 'error' ? 'bg-red-500' : 'bg-blue-500'
					}`;
					notification.textContent = message;
					document.body.appendChild(notification);

					setTimeout(() => {
						notification.remove();
					}, 3000);
				};
			});
		</script>
	}
}

// Enhanced AI-Powered LearningSessionPage - Now with AI chat and contextual learning
templ LearningSessionPage(
	user *models.User,
	session *models.LearningSession,
	prompt *models.LearningPrompt,
) {
	@Layout("AI Learning Session") {
		@Sidebar("learning", user)

		<main class="pt-16 md:pt-6 pb-6">
			<div class="main-container" x-data="{
				// Note-taking functionality
				showNoteModal: false,
				noteTitle: '',
				noteContent: '',
				autoTitleMode: true,
				folders: [],
				noteFolder: '',
				folderLoading: false,
				folderError: null,
				showFolderDropdown: false,
				noteFolderSearch: '',
				saveStatus: '',
				
				// AI-powered learning functionality
				chatMessage: '',
				isLoading: false,
				sessionStatus: if session != nil { '{ session.Status }' } else { 'active' },
				currentStep: if session != nil { session.CurrentStep } else { 1 },
				conceptsCompleted: if session != nil && session.ConceptsCompleted != nil { len(session.ConceptsCompleted) } else { 0 },
				assessmentsPassed: if session != nil { session.PassedAssessments } else { 0 },
				totalAssessments: if session != nil { session.TotalAssessments } else { 0 },

				async init() {
					// Pre-load folders when component initializes
					await this.loadFolders();
					// Initial scroll to bottom for conversation
					this.scrollToBottom();
				},

				// Load folders from API
				async loadFolders() {
					if (this.folders.length > 0) return; // Already loaded

					this.folderLoading = true;
					this.folderError = null;

					try {
						const response = await fetch('/api/folders');
						if (response.ok) {
							this.folders = await response.json();
							// Set default folder if none selected and folders exist
							if (!this.noteFolder && this.folders.length > 0) {
								this.noteFolder = this.folders[0].id;
							}
						} else {
							this.folderError = 'Failed to load folders';
						}
					} catch (error) {
						console.error('Failed to load folders:', error);
						this.folderError = 'Network error loading folders';
					} finally {
						this.folderLoading = false;
					}
				},

				// Filter folders based on search
				get filteredFolders() {
					if (!this.noteFolderSearch.trim()) return this.folders;
					const search = this.noteFolderSearch.toLowerCase();
					return this.folders.filter(folder => 
						folder.name.toLowerCase().includes(search)
					);
				},

				// Get folder name by ID
				getFolderName(folderId) {
					const folder = this.folders.find(f => f.id === folderId);
					return folder ? folder.name : 'Unknown Folder';
				},

				// Save note
				async saveNote() {
					// Validate required fields
					if (!this.noteContent.trim()) {
						this.saveStatus = 'error';
						setTimeout(() => { this.saveStatus = ''; }, 2000);
						return;
					}
					
					if (!this.noteFolder) {
						this.saveStatus = 'error';
						setTimeout(() => { this.saveStatus = ''; }, 2000);
						return;
					}

					// Title logic for auto-generation
					let finalTitle = '';
					if (!this.autoTitleMode && this.noteTitle.trim()) {
						finalTitle = this.noteTitle.trim();
					}

					const noteData = {
						title: finalTitle,
						body: this.noteContent,
						folder_id: this.noteFolder
					};

					fetch('/api/folders/' + noteData.folder_id + '/content', {
						method: 'POST',
						headers: { 'Content-Type': 'application/json' },
						body: JSON.stringify(noteData)
					})
					.then(response => {
						if (response.ok) {
							// Reset form
							this.noteContent = '';
							this.noteTitle = '';
							this.showNoteModal = false;
							this.saveStatus = 'success';
							setTimeout(() => { this.saveStatus = ''; }, 2000);
						} else {
							this.saveStatus = 'error';
							setTimeout(() => { this.saveStatus = ''; }, 2000);
						}
					})
					.catch(error => {
						console.error('Error saving note:', error);
						this.saveStatus = 'error';
						setTimeout(() => { this.saveStatus = ''; }, 2000);
					});
				},

				// AI Learning functions
				scrollToBottom() {
					const conversation = document.getElementById('conversation');
					if (conversation) {
						setTimeout(() => {
							conversation.scrollTop = conversation.scrollHeight;
						}, 100);
					}
				},

				addUserMessage(message) {
					if (!message.trim()) return;

					const conversation = document.getElementById('conversation');
					const userMessageHTML = `
						<div class='px-6 py-4 bg-blue-50 dark:bg-blue-900 border-b border-gray-200 dark:border-gray-700'>
							<div class='flex items-start space-x-3'>
								<div class='flex-shrink-0 w-8 h-8 bg-blue-100 dark:bg-blue-900 rounded-full flex items-center justify-center'>
									<span class='text-blue-600 dark:text-blue-400 text-sm font-medium'>U</span>
								</div>
								<div class='flex-1 min-w-0'>
									<div class='text-sm text-gray-900 dark:text-gray-100'>${message}</div>
								</div>
							</div>
						</div>
					`;
					conversation.insertAdjacentHTML('beforeend', userMessageHTML);
					this.scrollToBottom();
				}
			}">
				@EnhancedSessionHeader(session)
				@EnhancedLearningContent(session, prompt)
				@TakeNoteModal()
			</div>
		</main>

		<script>
			// AI Learning session functionality
			document.addEventListener('DOMContentLoaded', function() {
				// Session ID passed from server
				const sessionID = if session != nil { '"' + session.ID.String() + '"' } else { 'null' };
				
				// Next step functionality
				window.nextStep = function() {
					if (!sessionID) {
						console.error('No session ID available');
						return;
					}
					
					fetch(`/api/learning/session/${sessionID}/next-step`, {
						method: 'POST',
						headers: {
							'Content-Type': 'application/json',
						}
					})
					.then(response => response.json())
					.then(data => {
						if (data.success) {
							// Add AI response to conversation
							const conversation = document.getElementById('conversation');
							const aiMessageHTML = `
								<div class="px-6 py-4 border-b border-gray-200 dark:border-gray-700">
									<div class="flex items-start space-x-3">
										<div class="flex-shrink-0 w-8 h-8 bg-green-100 dark:bg-green-900 rounded-full flex items-center justify-center">
											<span class="text-green-600 dark:text-green-400 text-sm font-medium">AI</span>
										</div>
										<div class="flex-1 min-w-0">
											<div class="text-sm text-gray-900 dark:text-gray-100 prose prose-sm max-w-none dark:prose-dark">
												${data.content}
											</div>
										</div>
									</div>
								</div>
							`;
							conversation.insertAdjacentHTML('beforeend', aiMessageHTML);
							// Use Alpine.js global state instead
							const alpineEl = document.querySelector('[x-data]');
							if (alpineEl && alpineEl._x_dataStack) {
								alpineEl._x_dataStack[0].scrollToBottom();
							}
						}
					})
					.catch(error => {
						console.error('Error getting next step:', error);
					});
				};

				// Pause session
				window.pauseSession = function() {
					if (!sessionID) {
						console.error('No session ID available');
						return;
					}
					
					fetch(`/api/learning/session/${sessionID}/pause`, {
						method: 'PUT',
						headers: {
							'Content-Type': 'application/json',
						}
					})
					.then(response => response.json())
					.then(data => {
						if (data.success) {
							// Update Alpine.js state
							const alpineEl = document.querySelector('[x-data]');
							if (alpineEl && alpineEl._x_dataStack) {
								alpineEl._x_dataStack[0].sessionStatus = 'paused';
							}
							showNotification('Session paused successfully', 'success');
						}
					})
					.catch(error => {
						console.error('Error pausing session:', error);
					});
				};

				// Resume session
				window.resumeSession = function() {
					if (!sessionID) {
						console.error('No session ID available');
						return;
					}
					
					fetch(`/api/learning/session/${sessionID}/resume`, {
						method: 'PUT',
						headers: {
							'Content-Type': 'application/json',
						}
					})
					.then(response => response.json())
					.then(data => {
						if (data.success) {
							// Update Alpine.js state
							const alpineEl = document.querySelector('[x-data]');
							if (alpineEl && alpineEl._x_dataStack) {
								alpineEl._x_dataStack[0].sessionStatus = 'active';
							}
							showNotification('Session resumed successfully', 'success');
						}
					})
					.catch(error => {
						console.error('Error resuming session:', error);
					});
				};

				// Mark concept as complete
				window.markConceptComplete = function() {
					if (!sessionID) {
						console.error('No session ID available');
						return;
					}
					
					const conceptName = prompt('Enter the name of the concept you completed:');
					if (!conceptName) return;

					fetch(`/api/learning/session/${sessionID}/complete-concept`, {
						method: 'POST',
						headers: {
							'Content-Type': 'application/json',
						},
						body: JSON.stringify({ concept_name: conceptName })
					})
					.then(response => response.json())
					.then(data => {
						if (data.success) {
							showNotification(`Concept "${conceptName}" marked as complete`, 'success');
						}
					})
					.catch(error => {
						console.error('Error completing concept:', error);
					});
				};

				// Notification system
				window.showNotification = function(message, type = 'info') {
					const notification = document.createElement('div');
					notification.className = `fixed top-4 right-4 px-4 py-2 rounded-md text-white z-50 ${
						type === 'success' ? 'bg-green-500' : 
						type === 'error' ? 'bg-red-500' : 'bg-blue-500'
					}`;
					notification.textContent = message;
					document.body.appendChild(notification);

					setTimeout(() => {
						notification.remove();
					}, 3000);
				};
			});
		</script>
	}
}

// Enhanced Session Header with AI-powered learning controls
templ EnhancedSessionHeader(session *models.LearningSession) {
	<div class="flex flex-col md:flex-row md:items-center md:justify-between mb-6">
		<div class="flex-1">
			<h1 class="text-2xl font-bold text-gray-900 dark:text-white mb-2">
				if session.Topic != nil {
					{ session.Topic.Name }
				} else {
					Learning Session
				}
			</h1>
			<div class="flex items-center space-x-4 text-sm text-gray-500 dark:text-gray-400">
				if session.LearningMethod != nil {
					<span class="flex items-center">
						<span class="mr-1">{ session.LearningMethod.Icon }</span>
						{ session.LearningMethod.Name }
					</span>
				}
				<!-- Continuation indicator for returning users -->
				<span x-show="currentStep > 1 || conceptsCompleted > 0" class="flex items-center text-green-600 dark:text-green-400">
					<span class="mr-1">🔄</span>
					Continuing from progress
				</span>
				<span x-text="`Step ${currentStep}`"></span>
				<span x-text="`${conceptsCompleted} concepts completed`"></span>
				if session.TotalAssessments > 0 {
					<span x-text="`${assessmentsPassed}/${totalAssessments} assessments passed`"></span>
				}
			</div>
		</div>

		<!-- Session Controls -->
		<div class="flex items-center space-x-3 mt-4 md:mt-0">
			<!-- Progress Indicator -->
			<div class="hidden md:flex items-center space-x-2">
				<div class="w-20 bg-gray-200 rounded-full h-2 dark:bg-gray-700">
					<div class="bg-blue-600 h-2 rounded-full transition-all duration-300" 
					     x-bind:style="`width: ${totalAssessments > 0 ? (assessmentsPassed/totalAssessments)*100 : 0}%`"></div>
				</div>
				<span class="text-xs text-gray-500" x-text="`${Math.round(totalAssessments > 0 ? (assessmentsPassed/totalAssessments)*100 : 0)}%`"></span>
			</div>

			<!-- Action Buttons -->
			<button 
				@click="showNoteModal = true"
				class="inline-flex items-center px-3 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-md hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 dark:bg-gray-800 dark:text-gray-300 dark:border-gray-600 dark:hover:bg-gray-700">
				📝 Take Notes
			</button>

			<button 
				x-show="sessionStatus === 'active'"
				onclick="pauseSession()"
				class="inline-flex items-center px-3 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-md hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 dark:bg-gray-800 dark:text-gray-300 dark:border-gray-600 dark:hover:bg-gray-700">
				⏸️ Pause
			</button>

			<button 
				x-show="sessionStatus === 'paused'"
				onclick="resumeSession()"
				class="inline-flex items-center px-3 py-2 text-sm font-medium text-white bg-blue-600 border border-transparent rounded-md hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500">
				▶️ Resume
			</button>

			<a href="/learning" 
			   class="inline-flex items-center px-3 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-md hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 dark:bg-gray-800 dark:text-gray-300 dark:border-gray-600 dark:hover:bg-gray-700">
				← Back to Learning
			</a>
		</div>
	</div>
}

// Enhanced Learning Content with AI chat interface
templ EnhancedLearningContent(session *models.LearningSession, prompt *models.LearningPrompt) {
	<div class="grid grid-cols-1 gap-6">
		<!-- Learning Content Area -->
		<div class="bg-white dark:bg-gray-800 rounded-lg shadow">
			<!-- Initial AI Content Display -->
			<div id="learning-content" class="p-6 min-h-[400px] prose prose-lg max-w-none dark:prose-dark">
				if prompt != nil && prompt.AiResponse != nil {
					@AIContentDisplay(*prompt.AiResponse)
				} else {
					<div class="flex items-center justify-center h-40 text-gray-500 dark:text-gray-400">
						<div class="text-center">
							<div class="text-4xl mb-2">🤖</div>
							<p>AI content will appear here...</p>
							<p class="text-sm mt-2">Click "Continue" to start your AI-powered learning session</p>
						</div>
					</div>
				}
			</div>

			<!-- Conversation History -->
			<div id="conversation" class="border-t border-gray-200 dark:border-gray-700 max-h-96 overflow-y-auto">
				<!-- Conversation messages will be dynamically added here via HTMX and JavaScript -->
			</div>

			<!-- Chat Input -->
			<div class="p-6 border-t border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-750">
				<form id="chat-form" class="flex space-x-3" 
				      if session != nil {
				      	hx-post={ "/api/learning/session/" + session.ID.String() + "/interact" }
				      } else {
				      	hx-post="/api/learning/session/invalid/interact"
				      }
				      hx-target="#conversation"
				      hx-swap="beforeend"
				      hx-on::before-request="isLoading = true; addUserMessage(chatMessage)"
				      hx-on::after-request="isLoading = false; chatMessage = ''; scrollToBottom()">
					<div class="flex-1">
						<input 
							type="text" 
							name="message"
							x-model="chatMessage"
							placeholder="Ask a question or provide feedback..."
							class="block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm placeholder-gray-400 focus:outline-none focus:ring-blue-500 focus:border-blue-500 dark:bg-gray-700 dark:border-gray-600 dark:text-white dark:placeholder-gray-500"
							:disabled="isLoading || sessionStatus !== 'active'"
							@keydown.enter="if (!isLoading && sessionStatus === 'active') { $el.form.requestSubmit() }"
						/>
						<input type="hidden" name="interaction_type" value="user_question" />
					</div>
					<button 
						type="submit"
						:disabled="isLoading || !chatMessage.trim() || sessionStatus !== 'active'"
						class="inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md shadow-sm text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 disabled:opacity-50 disabled:cursor-not-allowed">
						<span x-show="!isLoading">Send</span>
						<span x-show="isLoading" class="flex items-center">
							<svg class="animate-spin -ml-1 mr-2 h-4 w-4 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
								<circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
								<path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
							</svg>
							Sending...
						</span>
					</button>
				</form>

				<!-- Contextual Action Buttons -->
				<div id="action-buttons" class="mt-4 flex flex-wrap gap-2">
					<button 
						onclick="nextStep()"
						:disabled="isLoading || sessionStatus !== 'active'"
						class="inline-flex items-center px-3 py-2 text-sm font-medium text-white bg-green-600 border border-transparent rounded-md hover:bg-green-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-green-500 disabled:opacity-50">
						Continue →
					</button>

					<button 
						onclick="markConceptComplete()"
						:disabled="isLoading || sessionStatus !== 'active'"
						class="inline-flex items-center px-3 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-md hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 dark:bg-gray-800 dark:text-gray-300 dark:border-gray-600 dark:hover:bg-gray-700 disabled:opacity-50">
						✅ Mark Complete
					</button>
				</div>
			</div>
		</div>
	</div>
}

// AIContentDisplay component for rendering AI-generated content
templ AIContentDisplay(content string) {
	<div class="ai-content">
		{ content }
	</div>
}

// Note: Other existing components like PlatformHeader, ActiveLearningSessionsSection, etc. remain unchanged.