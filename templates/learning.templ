package templates

import (
	"fmt"
	"mh-go/internal/models"
)

// Learning Platform Page - Simple version focused on learning paths
templ LearningPlatformPage(
	user *models.User,
	stats *models.DashboardStats,
	pathwayCards []models.LearningPathwayCard,
	topics []models.Topic,
	sessions []models.LearningSession,
	preferences *models.UserPreferences,
) {
	@Layout("Learn") {
		@Sidebar("learning", user)

		<main class="pt-16 md:pt-6 pb-6">
			<div class="main-container" x-data="{
				showModal: false,
				step: 1,
				topic: '',
				goal: '',
				selectedMethod: '',
				// Use server-provided pathway cards instead of duplicating data
				get availableMethods() {
					return [
						{ key: 'applied_laboratory', name: 'Applied Mastery Laboratory', description: 'Hands-on practice and real-world application' },
						{ key: 'foundation_discovery', name: 'Foundation Through Discovery', description: 'Explore concepts from first principles' },
						{ key: 'integration_transfer', name: 'Integration & Transfer System', description: 'Connect knowledge across domains' },
						{ key: 'mistake_learning_lab', name: 'Mistake-Based Learning Lab', description: 'Learn through errors and refinement' },
						{ key: 'problem_gymnasium', name: 'Problem-Solving Gymnasium', description: 'Build skills through targeted challenges' }
					];
				}
			}">
				<!-- Header with Start New Session Button -->
				<div class="flex flex-col sm:flex-row sm:items-center sm:justify-between mb-10">
					<div>
						<h1 class="text-3xl font-semibold tracking-tight text-gray-900">Learning Hub</h1>
						<p class="text-gray-600 mt-2 text-sm md:text-base">Continue your learning journey or start something new</p>
					</div>
					<button
						@click="showModal = true"
						class="mt-4 sm:mt-0 btn btn-primary btn-lg shadow-sm">
						<svg class="w-5 h-5 inline-block mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
						</svg>
						Start New Learning Session
					</button>
				</div>

				<!-- Active Learning Sessions Section -->
				if len(sessions) > 0 {
					<div class="surface-card p-6 mb-10">
						<div class="flex items-center justify-between mb-6">
							<h3 class="text-xl font-semibold text-gray-900">Your Active Sessions</h3>
							<span class="text-sm text-gray-500">{ fmt.Sprintf("%d session(s) in progress", len(sessions)) }</span>
						</div>
						<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
							for _, session := range sessions {
								<div class="surface-card p-6 hover:shadow-md transition-all duration-200">
									<!-- Learning Path Badge -->
									<div class="mb-4">
										<span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-[rgba(var(--color-teal-500-rgb),0.12)] text-[var(--color-primary)] border border-[rgba(var(--color-teal-500-rgb),0.3)]">
											<svg class="w-3 h-3 mr-1" fill="currentColor" viewBox="0 0 20 20">
												<path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path>
											</svg>
											{ session.LearningMethod.Name }
										</span>
									</div>

									<!-- Topic Title -->
									<h4 class="font-semibold text-gray-900 text-lg mb-3 leading-snug">{ session.Topic.Name }</h4>

									<!-- Goal section -->
									<div class="mb-4">
										<p class="text-sm text-gray-600 line-clamp-2">
											<span class="font-medium">Goal:</span> Master the fundamentals and gain practical understanding
										</p>
									</div>

									<!-- Progress indicator -->
									<div class="mb-4">
										<div class="flex items-center justify-between text-xs text-gray-500 mb-1">
											<span>Progress</span>
											<span>15%</span>
										</div>
										<div class="w-full bg-gray-200 rounded-full h-2 overflow-hidden">
											<div class="bg-[var(--color-primary)] h-2 rounded-full" style="width: 15%"></div>
										</div>
									</div>

									<!-- Continue button -->
									<a href={ templ.SafeURL("/learning/session/" + session.ID.String()) }
										class="w-full btn btn-primary btn-sm font-medium">
										<svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
											<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.828 14.828a4 4 0 01-5.656 0M9 10h1m4 0h1m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
										</svg>
										Continue Learning
									</a>
								</div>
							}
						</div>
					</div>
				}

				<!-- Learning Paths Section -->
				<div class="mb-6 md:mb-8">
					if len(sessions) > 0 {
						<h2 class="text-xl font-semibold text-gray-900 mb-2">Explore Learning Paths</h2>
						<p class="text-gray-600">Start a new learning adventure or explore different methods.</p>
					} else {
						<h2 class="text-xl md:text-2xl font-semibold text-gray-900 mb-2">Start Your Learning Journey</h2>
						<p class="text-gray-600 text-sm md:text-base">Choose your learning adventure and begin your journey.</p>
					}
				</div>

				<!-- Learning Paths Grid -->
				<div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-5 mb-10">
					for _, card := range pathwayCards {
						<div class="surface-card p-4 cursor-pointer transition-all duration-200 hover:-translate-y-1 border border-[var(--color-card-border)] hover:shadow-md focus:outline-none focus:ring-2 focus:ring-[var(--color-focus-ring)]"
				data-method-id={ card.ID.String() }
				data-method-name={ card.Name }
				data-method-key={ card.MethodKey }
				data-has-started={ templ.EscapeString(fmt.Sprintf("%t", card.HasStarted)) }
				@click="selectedMethod = { id: $el.dataset.methodId, name: $el.dataset.methodName, key: $el.dataset.methodKey, hasStarted: $el.dataset.hasStarted === 'true' }; showModal = true">

				<div class="text-left">
							<h4 class="text-sm font-semibold text-gray-900 mb-2">{ card.Name }</h4>
							<p class="text-xs text-gray-600 mb-4 line-clamp-3 min-h-[3.5rem]">{ card.Description }</p>

							<span class="inline-flex items-center px-3 py-1 rounded-full text-[10px] font-medium bg-[rgba(var(--color-teal-500-rgb),0.12)] text-[var(--color-primary)]">
								Start
							</span>
				</div>
						</div>
					}
				</div>

				<!-- Learning Session Modal -->
				<div x-show="showModal"
					class="fixed inset-0 z-50 flex items-center justify-center p-4"
					style="display: none;">
					<div class="fixed inset-0 bg-black bg-opacity-50" @click="showModal = false"></div>

					<div class="relative bg-white rounded-lg p-6 max-w-2xl w-full max-h-[90vh] overflow-y-auto">
						<button @click="showModal = false" class="absolute top-4 right-4 text-gray-400 hover:text-gray-600">
							<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
							</svg>
						</button>

						<!-- Progress Steps -->
						<div class="mb-6">
							<div class="flex items-center justify-between mb-4">
								<div class="flex items-center">
									<div class="flex items-center text-sm">
										<div class="flex-shrink-0 w-8 h-8 flex items-center justify-center rounded-full text-white font-medium"
											:class="step >= 1 ? 'bg-[var(--color-primary)]' : 'bg-gray-300'">1</div>
										<div class="ml-2 text-sm font-medium"
											:class="step >= 1 ? 'text-[var(--color-primary)]' : 'text-gray-500'">Subject</div>
									</div>
									<div class="ml-4 w-16 h-0.5 bg-gray-300"></div>
									<div class="ml-4 flex items-center text-sm">
										<div class="flex-shrink-0 w-8 h-8 flex items-center justify-center rounded-full text-white font-medium"
											:class="step >= 2 ? 'bg-[var(--color-primary)]' : 'bg-gray-300'">2</div>
										<div class="ml-2 text-sm font-medium"
											:class="step >= 2 ? 'text-[var(--color-primary)]' : 'text-gray-500'">Goal</div>
									</div>
									<div class="ml-4 w-16 h-0.5 bg-gray-300"></div>
									<div class="ml-4 flex items-center text-sm">
										<div class="flex-shrink-0 w-8 h-8 flex items-center justify-center rounded-full text-white font-medium"
											:class="step >= 3 ? 'bg-[var(--color-primary)]' : 'bg-gray-300'">3</div>
										<div class="ml-2 text-sm font-medium"
											:class="step >= 3 ? 'text-[var(--color-primary)]' : 'text-gray-500'">Method</div>
									</div>
								</div>
							</div>
						</div>

						<form hx-post="/learning/start" hx-target="#learning-result" @submit.prevent="$el.querySelector('button[type=submit]').disabled = true; htmx.process($el); setTimeout(() => showModal = false, 500)">
							<!-- Step 1: Subject -->
							<div x-show="step === 1" class="space-y-4">
								<div>
									<label class="block text-sm font-medium text-gray-900 mb-2">What do you want to learn?</label>
									<input type="text"
										name="topic"
										x-model="topic"
										required
										class="w-full px-3 py-2.5 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-[var(--color-primary)] focus:border-transparent"
										placeholder="e.g., Machine Learning, Spanish"/>
								</div>
								<div class="flex justify-end">
									<button type="button"
										@click="step = 2"
										:disabled="!topic.trim()"
										class="px-5 py-2.5 text-sm font-medium text-white bg-gray-900 border border-transparent rounded-lg hover:bg-gray-800 disabled:opacity-50 disabled:cursor-not-allowed">
										Next
									</button>
								</div>
							</div>

							<!-- Step 2: Goal -->
							<div x-show="step === 2" class="space-y-4">
								<div>
									<label class="block text-sm font-medium text-gray-900 mb-2">What's your learning goal?</label>
									<textarea name="user_prompt"
										x-model="goal"
										required
										rows="3"
										class="w-full px-3 py-2.5 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-[var(--color-primary)] focus:border-transparent resize-none"
										placeholder="What would you like to achieve?"></textarea>
								</div>
								<div class="flex justify-between">
									<button type="button"
										@click="step = 1"
										class="px-5 py-2.5 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-lg hover:bg-gray-50">
										Back
									</button>
									<button type="button"
										@click="step = 3"
										:disabled="!goal.trim()"
										class="px-5 py-2.5 text-sm font-medium text-white bg-gray-900 border border-transparent rounded-lg hover:bg-gray-800 disabled:opacity-50 disabled:cursor-not-allowed">
										Next
									</button>
								</div>
							</div>

							<!-- Step 3: Learning Method -->
							<div x-show="step === 3" class="space-y-4">
								<div>
									<label class="block text-sm font-medium text-gray-900 mb-3">Choose your learning style</label>
									<div class="space-y-3">
										<template x-for="method in availableMethods" :key="method.key">
											<div class="border border-gray-200 rounded-lg p-4 cursor-pointer hover:border-gray-300 transition-colors"
												:class="{ 'border-gray-900 bg-gray-50': selectedMethod === method.key }"
												@click="selectedMethod = method.key">
												<div class="flex items-start">
													<input type="radio"
													   name="method_key"
													   :value="method.key"
													   :checked="selectedMethod === method.key"
													   class="mt-1 mr-3"
													   required>
													<div class="flex-1">
														<h4 class="font-medium text-gray-900 text-sm mb-1" x-text="method.name"></h4>
														<p class="text-xs text-gray-600" x-text="method.description"></p>
													</div>
												</div>
											</div>
										</template>
									</div>
								</div>
								<div class="flex justify-between">
									<button type="button"
										@click="step = 2"
										class="px-5 py-2.5 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-lg hover:bg-gray-50">
										Back
									</button>
									<button type="submit"
										:disabled="!selectedMethod"
										class="px-5 py-2.5 text-sm font-medium text-white bg-gray-900 border border-transparent rounded-lg hover:bg-gray-800 disabled:opacity-50 disabled:cursor-not-allowed">
										Start Learning
									</button>
								</div>
							</div>
						</form>
					</div>
				</div>
				<div id="learning-result"></div>
			</div>
		</main>
	}
}

// LearningSessionPage - Immersive learning layout with clean interface and sidebar navigation
templ LearningSessionPage(
	user *models.User,
	session *models.LearningSession,
	prompt *models.LearningPrompt,
) {
	@Layout("learning") {
		<div class="flex h-screen overflow-hidden bg-gray-50 relative" x-data="{
			showNoteModal: false,
			noteTitle: '',
			noteContent: '',
			folders: [],
			noteFolder: '',
			folderLoading: false,
			folderError: null,
			showFolderDropdown: false,
			noteFolderSearch: '',

			async init() {
				// Pre-load folders when component initializes
				await this.loadFolders();
			},

			// Load folders from API
			async loadFolders() {
				if (this.folders.length > 0) return; // Already loaded

				this.folderLoading = true;
				this.folderError = null;

				try {
					const response = await fetch('/api/folders');
					if (response.ok) {
						this.folders = await response.json();
						// Set default folder if none selected and folders exist
						if (!this.noteFolder && this.folders.length > 0) {
							this.noteFolder = this.folders[0].id;
						}
					} else {
						this.folderError = 'Failed to load folders';
					}
				} catch (error) {
					console.error('Failed to load folders:', error);
					this.folderError = 'Network error loading folders';
				} finally {
					this.folderLoading = false;
				}
			},

			// Helper method to get folder name by ID
			getFolderName(folderId) {
				const folder = this.folders.find(f => f.id === folderId);
				return folder ? folder.name : 'Unknown Folder';
			},

			// Computed property for filtered folders
			get filteredFolders() {
				if (!this.noteFolderSearch.trim()) return this.folders;
				return this.folders.filter(folder =>
					folder.name.toLowerCase().includes(this.noteFolderSearch.toLowerCase()) ||
					(folder.description && folder.description.toLowerCase().includes(this.noteFolderSearch.toLowerCase()))
				);
			},

			// Save note function with smart title defaulting
			saveNote() {
				if (!this.noteContent.trim() || !this.noteFolder) {
					// If no folder selected, show error
					if (!this.noteFolder) {
						const btn = document.querySelector('[x-data] button');
						if (btn) {
							btn.classList.add('bg-red-500');
							setTimeout(() => btn.classList.remove('bg-red-500'), 1000);
						}
					}
					return;
				}

				// Smart title logic: use noteTitle if provided, otherwise default to lesson title + date
				const defaultTitle = `{ session.Topic.Name } - ${ new Date().toLocaleDateString() }`;
				const finalTitle = this.noteTitle.trim() || defaultTitle;

				const noteData = {
					title: finalTitle,
					description: 'Note from learning session',
					content_type: 'text',
					body: this.noteContent,
					folder_id: this.noteFolder
				};

				fetch('/api/folders/' + noteData.folder_id + '/content', {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify(noteData)
				})
				.then(response => {
					if (response.ok) {
						// Reset form
						this.noteContent = '';
						this.noteTitle = '';
						this.showNoteModal = false;
						// Show success feedback
						const btn = document.querySelector('[x-data] button');
						if (btn) {
							btn.classList.add('bg-green-500');
							setTimeout(() => btn.classList.remove('bg-green-500'), 1000);
						}
					} else {
						// Simple error feedback
						const btn = document.querySelector('[x-data] button');
						if (btn) {
							btn.classList.add('bg-red-500');
							setTimeout(() => btn.classList.remove('bg-red-500'), 1000);
						}
					}
				})
				.catch(error => {
					console.error('Error saving note:', error);
					const btn = document.querySelector('[x-data] button');
					if (btn) {
						btn.classList.add('bg-red-500');
						setTimeout(() => btn.classList.remove('bg-red-500'), 1000);
					}
				});
			}
		}">
			<!-- Responsive Sticky Note Button -->
			<div class="fixed z-40">
				<!-- Desktop: Top right corner -->
				<div class="hidden md:block fixed top-20 right-6">
					<button
						@click="showNoteModal = !showNoteModal"
						class="group relative p-4 bg-yellow-400 hover:bg-yellow-500 rounded-full shadow-lg hover:shadow-xl transition-all duration-200 transform hover:scale-110">
						<svg class="w-6 h-6 text-gray-800" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"></path>
						</svg>
						<span class="absolute -top-12 right-0 bg-gray-800 text-white text-xs px-2 py-1 rounded-md opacity-0 group-hover:opacity-100 transition-opacity whitespace-nowrap">
							Take Note
						</span>
					</button>
				</div>

				<!-- Mobile: Bottom right corner -->
				<div class="md:hidden fixed bottom-6 right-6">
					<button
						@click="showNoteModal = !showNoteModal"
						class="group relative p-3 bg-yellow-400 hover:bg-yellow-500 rounded-full shadow-lg transition-all duration-200">
						<svg class="w-5 h-5 text-gray-800" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"></path>
						</svg>
					</button>
				</div>
			</div>

			@Sidebar("learning", user)

			<main class="flex-1 overflow-y-auto pt-16 md:pt-6">
				<div class="container mx-auto px-4 md:px-6 max-w-4xl">
					<!-- Clean, minimal learning session header -->
					<div class="bg-white rounded-lg border border-gray-200 p-6 md:p-8 shadow-sm mb-6">
						<!-- Title -->
						<div class="mb-6">
							<h1 class="text-2xl md:text-3xl font-bold text-gray-900 mb-2">{ session.Topic.Name }</h1>
							<p class="text-gray-600">Focus on understanding and mastery</p>
						</div>

						<!-- Learning Method -->
						<div class="mb-6">
							<div class="flex items-center space-x-3">
								<span class="text-sm font-medium text-gray-700">Learning Method:</span>
								<span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-[rgba(var(--color-teal-500-rgb),0.12)] text-[var(--color-primary)] border border-[rgba(var(--color-teal-500-rgb),0.3)]">
									{ session.LearningMethod.Name }
								</span>
							</div>
						</div>

						<!-- Goal -->
						<div class="border-t border-gray-200 pt-6">
							<div class="flex items-start space-x-3">
								<div class="flex-shrink-0">
									<div class="w-8 h-8 bg-[rgba(var(--color-teal-500-rgb),0.12)] rounded-full flex items-center justify-center">
										<svg class="w-4 h-4 text-[var(--color-primary)]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
											<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
										</svg>
									</div>
								</div>
								<div class="flex-1">
									<h3 class="text-sm font-medium text-gray-900 mb-1">Your Goal</h3>
									if prompt != nil {
										<p class="text-gray-700">{ prompt.UserPrompt }</p>
									} else {
										<p class="text-gray-700">Master the fundamentals of { session.Topic.Name } through structured learning and practice.</p>
									}
								</div>
							</div>
						</div>
					</div>

					<!-- Content area placeholder -->
					<div class="bg-white rounded-lg border border-gray-200 p-6 shadow-sm">
						<div class="text-center py-12">
							<svg class="w-12 h-12 text-gray-400 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
							</svg>
							<h3 class="text-lg font-medium text-gray-900 mb-2">Ready to Learn</h3>
							<p class="text-gray-600">Your learning space is ready. Take notes using the sticky button as you progress through your session.</p>
						</div>
					</div>
				</div>
			</main>

			<!-- Sticky Note Modal -->
			<div x-show="showNoteModal"
				x-transition:enter="transition ease-out duration-200"
				x-transition:enter-start="opacity-0 scale-95"
				x-transition:enter-end="opacity-100 scale-100"
				x-transition:leave="transition ease-in duration-150"
				x-transition:leave-start="opacity-100 scale-100"
				x-transition:leave-end="opacity-0 scale-95"
				class="fixed z-50"
				:class="{
					'top-20 right-6': window.innerWidth >= 768,
					'bottom-20 right-6': window.innerWidth < 768
				}">

				<div class="bg-white rounded-lg shadow-xl border border-gray-200 w-80 md:w-96">
					<!-- Header -->
					<div class="flex items-center justify-between p-4 border-b border-gray-200">
						<h3 class="text-lg font-medium text-gray-900">Quick Note</h3>
						<button @click="showNoteModal = false" class="text-gray-400 hover:text-gray-600">
							<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
							</svg>
						</button>
					</div>

					<!-- Content -->
					<div class="p-4">
						<p class="text-sm text-gray-600 mb-3">Capture your thoughts during this learning session</p>

						<!-- Title Input -->
						<div class="mb-3">
							<label class="block text-sm font-medium text-gray-700 mb-1">Title (optional)</label>
							<input
								type="text"
								x-model="noteTitle"
								class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-[var(--color-primary)] focus:border-transparent"
								:placeholder="`{ session.Topic.Name } - ${ new Date().toLocaleDateString() }`">
						</div>

						<!-- Note Content -->
						<div class="mb-3">
							<label class="block text-sm font-medium text-gray-700 mb-1">Notes</label>
							<textarea
								x-model="noteContent"
								rows="4"
								class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-[var(--color-primary)] focus:border-transparent resize-none"
								placeholder="What's on your mind?"></textarea>
						</div>

						<!-- Folder Selection -->
						<div class="mb-3">
							<label class="block text-sm font-medium text-gray-700 mb-2">Save to Folder</label>

							<!-- Custom Dropdown -->
							<div class="relative">
								<button type="button"
										@click="showFolderDropdown = !showFolderDropdown; $nextTick(() => $refs.folderSearch?.focus())"
										@keydown.escape="showFolderDropdown = false"
										class="w-full px-3 py-2 text-left text-sm bg-white border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-[var(--color-primary)] focus:border-transparent flex items-center justify-between">
									<span x-show="!noteFolder" class="text-gray-500">Select a folder...</span>
									<span x-show="noteFolder" x-text="getFolderName(noteFolder)" class="text-gray-900"></span>
									<svg class="w-4 h-4 text-gray-400 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
									</svg>
								</button>

								<!-- Dropdown Menu -->
								<div x-show="showFolderDropdown"
									 x-transition:enter="transition ease-out duration-100"
									 x-transition:enter-start="opacity-0 transform scale-95"
									 x-transition:enter-end="opacity-100 transform scale-100"
									 x-transition:leave="transition ease-in duration-75"
									 x-transition:leave-start="opacity-100 transform scale-100"
									 x-transition:leave-end="opacity-0 transform scale-95"
									 @click.away="showFolderDropdown = false"
									 class="absolute z-50 w-full mt-1 bg-white border border-gray-200 rounded-lg shadow-lg">

									<!-- Search Input -->
									<div class="p-2 border-b border-gray-200">
										<input type="text"
											   x-model="noteFolderSearch"
											   x-ref="folderSearch"
											   placeholder="Search folders..."
											   class="w-full px-2 py-1 text-sm border border-gray-300 rounded focus:outline-none focus:ring-1 focus:ring-[var(--color-primary)] focus:border-transparent">
									</div>

									<!-- Folder List -->
									<div class="max-h-32 overflow-y-auto overscroll-contain">
										<div x-show="folderLoading" class="p-3 text-center text-sm text-gray-500">
											Loading folders...
										</div>
										<div x-show="folderError" class="p-3 text-center text-sm text-red-600">
											<span x-text="folderError"></span>
										</div>
										<template x-for="folder in filteredFolders" :key="folder.id">
											<div @click="noteFolder = folder.id; showFolderDropdown = false; noteFolderSearch = ''"
												 class="px-3 py-2 text-sm cursor-pointer hover:bg-[rgba(var(--color-teal-500-rgb),0.06)] flex items-center">
												<svg class="w-4 h-4 text-gray-400 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
													<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2H5a2 2 0 00-2-2z"></path>
													<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 5a2 2 0 012-2h4a2 2 0 012 2v2H8V5z"></path>
												</svg>
												<span x-text="folder.name" class="text-gray-900"></span>
											</div>
										</template>
										<div x-show="!folderLoading && !folderError && filteredFolders.length === 0" class="p-3 text-center text-sm text-gray-500">
											No folders found
										</div>
									</div>
								</div>
							</div>
						</div>

						<div class="flex justify-end gap-2 mt-4">
							<button
								@click="showNoteModal = false"
								class="btn btn-secondary text-sm">
								Cancel
							</button>
							<button
								@click="saveNote()"
								:disabled="!noteContent.trim() || !noteFolder"
								class="btn btn-primary text-sm disabled:opacity-50 disabled:cursor-not-allowed">
								Save
							</button>
						</div>
					</div>
				</div>
			</div>
		</div>
	}
}

// Note: AIPromptDisplay and getMethodName are implemented in their dedicated templ/helper files to avoid duplication.
