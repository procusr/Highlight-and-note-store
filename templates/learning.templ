						<div class="mb-4">
							<label class="block text-sm font-medium text-gray-700 mb-2">What do you want to learn?</label>
							<input type="text" name="topic" required class="w-full px-3 py-2 border border-gray-300 rounded-md focus:ring-blue-500 focus:border-blue-500" placeholder="e.g., Machine Learning, Spanish Grammar, Mathematics"/>
						</div>

						<div class="mb-6">
							<label class="block text-sm font-medium text-gray-700 mb-2">Learning Goal</label>
							<textarea name="user_prompt" required rows="3" class="w-full px-3 py-2 border border-gray-300 rounded-md focus:ring-blue-500 focus:border-blue-500" placeholder="What would you like to achieve?"></textarea>
						</div>

						<div class="flex justify-end space-x-3">
							<button type="button" @click="showModal = false" class="px-4 py-2 text-sm font-medium text-gray-700 bg-gray-100 border border-gray-300 rounded-md hover:bg-gray-200 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500">
								Cancel
							</button>
							<button type="submit" class="px-4 py-2 text-sm font-medium text-white bg-blue-600 border border-transparent rounded-md hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500">
								Start Learning
							</button>
						</div>
					</form>
				</div>
			</div>
		</div>
	</div>
}

// LearningPathwaysGrid - compact grid for HTMX responses
templ LearningPathwaysGrid(pathwayCards []models.LearningPathwayCard) {
	<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4" x-data="{ showModal: false, selectedMethod: null }">
		for _, card := range pathwayCards {
			<div class="bg-white rounded-lg border border-gray-200 p-3 cursor-pointer hover:shadow-md transition-all duration-200 hover:-translate-y-1"
				data-method-id={ card.ID.String() }
				data-method-name={ card.Name }
				data-method-key={ card.MethodKey }
				data-has-started={ templ.EscapeString(fmt.Sprintf("%t", card.HasStarted)) }
				@click="selectedMethod = { id: $el.dataset.methodId, name: $el.dataset.methodName, key: $el.dataset.methodKey, hasStarted: $el.dataset.hasStarted === 'true' }; showModal = true">

								<h4 class="text-sm font-semibold text-gray-900 mb-1">{ card.Name }</h4>
				<p class="text-xs text-gray-600 mb-2">{ card.Description }</p>

				if card.HasStarted {
					<div class="mt-2">
						<div class="flex justify-between text-xs text-gray-600 mb-1">
							<span>Progress</span>
							<span>{ card.ProgressPercent }%</span>
						</div>
						<div class="w-full bg-gray-200 rounded-full h-1.5">
							<div class="bg-blue-600 h-1.5 rounded-full" style={ fmt.Sprintf("width: %d%%", card.ProgressPercent) }></div>
						</div>
					</div>
				} else {
					<span class="inline-flex items-center px-2 py-1 rounded-full text-xs font-medium bg-gray-100 text-gray-700">
						Start
					</span>
				}
			</div>
		}
	</div>
}

// LearningSessionPage - Immersive learning layout with clean interface and sidebar navigation
templ LearningSessionPage(
	user *models.User,
	session *models.LearningSession,
	prompt *models.LearningPrompt,
) {
	@Layout("learning") {
		<div class="flex h-screen overflow-hidden bg-gray-50">
			@Sidebar("learning", user)

			<main class="flex-1 overflow-y-auto pt-16 md:pt-6 pb-6">
				<div class="container mx-auto px-4 md:px-6">
			<!-- Display the prompt if available -->
			if prompt != nil {
				<div class="bg-white rounded-lg border border-gray-200 p-4 md:p-6 shadow-sm mb-6">
					<div class="bg-blue-50 border border-blue-200 rounded-lg p-4 mb-4">
						<div class="flex justify-between items-center mb-2">
							<h4 class="font-semibold text-blue-900">Your Learning Goal</h4>
							<span class="text-xs bg-green-100 text-green-700 px-2 py-1 rounded-full">Active</span>
						</div>
						<p class="text-blue-800 text-sm">{ prompt.UserPrompt }</p>
					</div>

					<!-- Progress indicator -->
					<div class="mb-6">
						<div class="flex items-center justify-between mb-2">
							<span class="text-sm font-medium text-gray-700">Progress</span>
							<span class="text-sm text-gray-600">25%</span>
						</div>
						<div class="w-full bg-gray-200 rounded-full h-2.5">
							<div class="bg-blue-600 h-2.5 rounded-full" style="width: 25%"></div>
						</div>
					</div>

					<!-- Learning content -->
					<div class="prose prose-sm md:prose max-w-none">
						if prompt.AiResponse != nil {
							<!-- Display AI-generated content -->
							<div>{ string(*prompt.AiResponse) }</div>
						} else {
							<h2>Introduction to { session.Topic.Name }</h2>
							<p>This is where the AI-generated learning content will appear. The interface is designed to be clean and focused, allowing learners to concentrate on the material without distractions.</p>

							<h3>Key Concepts</h3>
							<ul>
								<li>First important concept about { session.Topic.Name }</li>
								<li>Second important concept with more details and explanation</li>
								<li>Third concept that builds on previous knowledge</li>
							</ul>

							<p>The content will be structured to support progressive disclosure, showing only essential information initially and allowing users to drill down for details as needed.</p>
						}
					</div>
				</div>
			} else {
				<div class="bg-white rounded-lg border border-gray-200 p-4 md:p-6 shadow-sm mb-6">
					<!-- Progress indicator -->
					<div class="mb-6">
						<div class="flex items-center justify-between mb-2">
							<span class="text-sm font-medium text-gray-700">Progress</span>
							<span class="text-sm text-gray-600">25%</span>
						</div>
						<div class="w-full bg-gray-200 rounded-full h-2.5">
							<div class="bg-blue-600 h-2.5 rounded-full" style="width: 25%"></div>
						</div>
					</div>

					<!-- Learning content -->
					<div class="prose prose-sm md:prose max-w-none">
						if prompt.AiResponse != nil {
							<!-- Display AI-generated content -->
							<div>{ string(*prompt.AiResponse) }</div>
						} else {
							<h2>Introduction to { session.Topic.Name }</h2>
							<p>This is where the AI-generated learning content will appear. The interface is designed to be clean and focused, allowing learners to concentrate on the material without distractions.</p>

							<h3>Key Concepts</h3>
							<ul>
								<li>First important concept about { session.Topic.Name }</li>
								<li>Second important concept with more details and explanation</li>
								<li>Third concept that builds on previous knowledge</li>
							</ul>

							<p>The content will be structured to support progressive disclosure, showing only essential information initially and allowing users to drill down for details as needed.</p>
						}
					</div>
				</div>
			}

			<!-- Interactive elements -->
			<div class="bg-white rounded-lg border border-gray-200 p-4 md:p-6 shadow-sm">
				<h3 class="text-lg font-medium text-gray-900 mb-4">Knowledge Check</h3>

				<div class="space-y-4">
					<!-- Example multiple choice question -->
					<div class="p-4 bg-blue-50 border border-blue-200 rounded-lg">
						<p class="text-gray-900 font-medium mb-3">What is the main benefit of { session.Topic.Name }?</p>
						<div class="space-y-2">
							<label class="flex items-center p-3 bg-white border border-gray-200 rounded-md hover:bg-gray-50 cursor-pointer">
								<input type="radio" name="question1" class="h-4 w-4 text-blue-600 focus:ring-blue-500 border-gray-300" />
								<span class="ml-3 text-gray-900">Option A</span>
							</label>
							<label class="flex items-center p-3 bg-white border border-gray-200 rounded-md hover:bg-gray-50 cursor-pointer">
								<input type="radio" name="question1" class="h-4 w-4 text-blue-600 focus:ring-blue-500 border-gray-300" />
								<span class="ml-3 text-gray-900">Option B</span>
							</label>
							<label class="flex items-center p-3 bg-white border border-gray-200 rounded-md hover:bg-gray-50 cursor-pointer">
								<input type="radio" name="question1" class="h-4 w-4 text-blue-600 focus:ring-blue-500 border-gray-300" />
								<span class="ml-3 text-gray-900">Option C</span>
							</label>
						</div>
						<button class="mt-4 px-4 py-2 bg-blue-600 text-white rounded-md hover:bg-blue-700 transition-colors text-sm font-medium">Submit Answer</button>
					</div>
				</div>
			</div>
				<!-- Footer with actions -->
				<div class="bg-white border-t border-gray-200 py-3 px-4 mt-6 rounded-lg">
					<div class="flex items-center justify-between">
						<button class="px-4 py-2 bg-gray-100 text-gray-700 rounded-md hover:bg-gray-200 transition-colors text-sm font-medium flex items-center">
							<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-1" viewBox="0 0 20 20" fill="currentColor">
								<path fill-rule="evenodd" d="M3 5a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zM3 10a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zM3 15a1 1 0 011-1h6a1 1 0 110 2H4a1 1 0 01-1-1z" clip-rule="evenodd" />
							</svg>
							Take Notes
						</button>
						<div class="flex space-x-3">
							<button class="px-4 py-2 bg-gray-100 text-gray-700 rounded-md hover:bg-gray-200 transition-colors text-sm font-medium">
								Previous
							</button>
							<button class="px-4 py-2 bg-blue-600 text-white rounded-md hover:bg-blue-700 transition-colors text-sm font-medium">
								Next
							</button>
						</div>
					</div>
				</div>
			</div>
				</main>
			</div>
		}
}