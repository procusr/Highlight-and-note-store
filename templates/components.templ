package templates

import "mh-go/internal/models"

// Base layout template
templ Layout(title string) {
	<!DOCTYPE html>
	<html lang="en">
	<head>
		<meta charset="UTF-8"/>
		<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
		<title>{ title } - MH-Go</title>
		<script src="https://cdn.tailwindcss.com"></script>
		<script src="https://unpkg.com/htmx.org@1.9.6"></script>
		<link rel="stylesheet" href="/static/style.css"/>
		<style>
			.line-clamp-2 {
				display: -webkit-box;
				-webkit-line-clamp: 2;
				-webkit-box-orient: vertical;
				overflow: hidden;
			}
		</style>
	</head>
	<body class="bg-gray-50 min-h-screen">
		{ children... }
	</body>
	</html>
}

// Tags Input Component for global search
templ TagsInput() {
	<div class="w-full">
		<div class="relative">
			<div
				id="tags-container"
				class="flex flex-wrap items-center gap-1 w-full px-2 py-1.5 md:px-3 md:py-2 border border-gray-300 rounded-md bg-white text-xs md:text-sm focus-within:ring-2 focus-within:ring-gray-500 focus-within:border-gray-500 min-h-[32px] md:min-h-[40px]"
				onclick="document.getElementById('tags-input').focus()"
			>
				<!-- Tags will be dynamically added here -->
				<input
					id="tags-input"
					type="text"
					placeholder="Search..."
					class="flex-1 min-w-[60px] md:min-w-[120px] outline-none border-none bg-transparent text-xs md:text-sm placeholder-gray-500"
					onkeydown="handleTagInput(event)"
					oninput="handleTagSearch(event)"
				/>
			</div>
			<!-- Search suggestions dropdown -->
			<div id="search-suggestions" class="absolute top-full left-0 right-0 bg-white border border-gray-200 rounded-md shadow-lg mt-1 max-h-48 overflow-y-auto hidden z-50">
				<!-- Suggestions will be populated here -->
			</div>
		</div>
	</div>
}

// Navigation component - Fixed mobile layout and desktop centered layout
templ Navigation(user *models.User) {
	<header class="bg-white border-b border-gray-200 fixed top-0 left-0 right-0 z-50">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<!-- Mobile Layout -->
			<div class="flex items-center justify-between h-16 md:hidden">
				<!-- Left: Mobile menu button -->
				<button
					id="mobile-menu-button"
					class="p-2 rounded-md text-gray-600 hover:text-gray-900 hover:bg-gray-100 focus:outline-none focus:ring-2 focus:ring-gray-500"
					onclick="toggleMobileMenu()"
				>
					<svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
					</svg>
				</button>

				<!-- Center: Mobile Logo and Search -->
				<div class="flex items-center space-x-2 flex-1 justify-center max-w-xs">
					if user != nil {
						<span class="w-8 h-8 bg-gray-900 rounded flex items-center justify-center flex-shrink-0">
							<span class="text-white font-bold text-sm">M</span>
						</span>
						<div class="flex-1 min-w-0">
							@TagsInput()
						</div>
					}
				</div>

				<!-- Right: User menu -->
				if user != nil {
					<div class="relative">
						<button
							id="user-menu-button"
							class="p-2 rounded-md text-gray-600 hover:text-gray-900 hover:bg-gray-100 focus:outline-none focus:ring-2 focus:ring-gray-500"
							onclick="toggleUserMenu()"
						>
							<div class="w-8 h-8 bg-gray-300 rounded-full flex items-center justify-center">
								<svg class="w-5 h-5 text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
								</svg>
							</div>
						</button>

						<!-- User dropdown menu -->
						<div id="user-menu" class="absolute right-0 mt-2 w-48 bg-white rounded-md shadow-lg border border-gray-200 hidden">
							<div class="py-1">
								<div class="px-4 py-2 text-sm text-gray-700 border-b">
									<span class="font-medium">{ user.Email }</span>
								</div>
								<a href="/settings" class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100">Settings</a>
								<form hx-post="/logout" hx-redirect="/" class="block">
									<button type="submit" class="w-full text-left px-4 py-2 text-sm text-gray-700 hover:bg-gray-100">
										Sign out
									</button>
								</form>
							</div>
						</div>
					</div>
				}
			</div>

			<!-- Desktop Layout -->
			<div class="hidden md:flex items-center justify-between h-16">
				<!-- Left: Empty space for balance -->
				<div class="w-20"></div>

				<!-- Center: Logo, Search, and User info -->
				<div class="flex items-center justify-center space-x-6">
					if user != nil {
						<!-- Desktop Logo -->
						<div class="flex items-center">
							<span class="text-2xl font-bold text-gray-900">MH-Go</span>
						</div>

						<!-- Global search bar -->
						<div class="flex-1 max-w-md">
							@TagsInput()
						</div>

						<!-- User info -->
						<div class="relative">
							<button
								id="user-menu-button-desktop"
								class="flex items-center space-x-2 p-2 rounded-md text-gray-600 hover:text-gray-900 hover:bg-gray-100 focus:outline-none focus:ring-2 focus:ring-gray-500"
								onclick="toggleUserMenuDesktop()"
							>
								<div class="w-8 h-8 bg-gray-300 rounded-full flex items-center justify-center">
									<svg class="w-5 h-5 text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
									</svg>
								</div>
								<span class="text-sm font-medium">{ user.Email }</span>
								<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
								</svg>
							</button>

							<!-- User dropdown menu -->
							<div id="user-menu-desktop" class="absolute right-0 mt-2 w-48 bg-white rounded-md shadow-lg border border-gray-200 hidden">
								<div class="py-1">
									<a href="/settings" class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100">Settings</a>
									<form hx-post="/logout" hx-redirect="/" class="block">
										<button type="submit" class="w-full text-left px-4 py-2 text-sm text-gray-700 hover:bg-gray-100">
											Sign out
										</button>
									</form>
								</div>
							</div>
						</div>
					}
				</div>

				<!-- Right: Empty space for balance -->
				<div class="w-20"></div>
			</div>
		</div>
	</header>

	<!-- JavaScript for tags input and user menu -->
	<script>
		// User menu toggle for mobile
		function toggleUserMenu() {
			const menu = document.getElementById('user-menu');
			if (menu) {
				menu.classList.toggle('hidden');
			}
		}

		// User menu toggle for desktop
		function toggleUserMenuDesktop() {
			const menu = document.getElementById('user-menu-desktop');
			if (menu) {
				menu.classList.toggle('hidden');
			}
		}

		// Close user menus when clicking outside
		document.addEventListener('click', function(e) {
			// Mobile menu
			const mobileButton = document.getElementById('user-menu-button');
			const mobileMenu = document.getElementById('user-menu');
			if (mobileButton && mobileMenu && !mobileButton.contains(e.target) && !mobileMenu.contains(e.target)) {
				mobileMenu.classList.add('hidden');
			}

			// Desktop menu
			const desktopButton = document.getElementById('user-menu-button-desktop');
			const desktopMenu = document.getElementById('user-menu-desktop');
			if (desktopButton && desktopMenu && !desktopButton.contains(e.target) && !desktopMenu.contains(e.target)) {
				desktopMenu.classList.add('hidden');
			}
		});

		// Tags input functionality
		let currentTags = [];

		function handleTagInput(event) {
			const input = event.target;
			const value = input.value.trim();

			if (event.key === 'Enter' || event.key === ',') {
				event.preventDefault();
				if (value && !currentTags.includes(value)) {
					addTag(value);
					input.value = '';
					hideSearchSuggestions();
				}
			} else if (event.key === 'Backspace' && value === '') {
				// Remove last tag when backspace is pressed on empty input
				if (currentTags.length > 0) {
					removeTag(currentTags[currentTags.length - 1]);
				}
			}
		}

		function handleTagSearch(event) {
			const value = event.target.value.trim();
			if (value.length > 1) {
				showSearchSuggestions(value);
			} else {
				hideSearchSuggestions();
			}
		}

		function addTag(tag) {
			currentTags.push(tag);
			renderTags();
			performSearch();
		}

		function removeTag(tag) {
			currentTags = currentTags.filter(t => t !== tag);
			renderTags();
			performSearch();
		}

		function renderTags() {
			const container = document.getElementById('tags-container');
			const input = document.getElementById('tags-input');

			// Remove existing tags
			const existingTags = container.querySelectorAll('.tag');
			existingTags.forEach(tag => tag.remove());

			// Add current tags
			currentTags.forEach(tag => {
				const tagElement = document.createElement('span');
				tagElement.className = 'tag inline-flex items-center px-2 py-1 rounded-md text-xs font-medium bg-gray-100 text-gray-800';
				tagElement.innerHTML = `
					${tag}
					<button onclick="removeTag('${tag}')" class="ml-1 text-gray-500 hover:text-gray-700">
						<svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
						</svg>
					</button>
				`;
				container.insertBefore(tagElement, input);
			});
		}

		function showSearchSuggestions(query) {
			// Mock suggestions - in real app, this would be an API call
			const mockSuggestions = ['documents', 'images', 'notes', 'projects', 'work', 'personal'];
			const filteredSuggestions = mockSuggestions.filter(s =>
				s.toLowerCase().includes(query.toLowerCase()) && !currentTags.includes(s)
			);

			const suggestionsContainer = document.getElementById('search-suggestions');
			suggestionsContainer.innerHTML = '';

			filteredSuggestions.forEach(suggestion => {
				const item = document.createElement('div');
				item.className = 'px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 cursor-pointer';
				item.textContent = suggestion;
				item.onclick = () => {
					addTag(suggestion);
					document.getElementById('tags-input').value = '';
					hideSearchSuggestions();
				};
				suggestionsContainer.appendChild(item);
			});

			suggestionsContainer.classList.remove('hidden');
		}

		function hideSearchSuggestions() {
			document.getElementById('search-suggestions').classList.add('hidden');
		}

		function performSearch() {
			// Implement search functionality here
			console.log('Searching for tags:', currentTags);
			// You can add HTMX call here to search content
		}
	</script>
}

// Sidebar Navigation Component - Mobile responsive
templ Sidebar(currentPage string) {
	<!-- Mobile overlay - Lower z-index and click should close menu -->
	<div id="sidebar-overlay" class="fixed inset-0 bg-gray-600 bg-opacity-50 z-20 hidden md:hidden" onclick="closeMobileMenu()"></div>

	<aside id="sidebar" class="fixed inset-y-0 left-0 w-64 bg-white border-r border-gray-200 pt-16 z-30 transform -translate-x-full md:translate-x-0 transition-transform duration-300 ease-in-out">
		<nav class="px-4 py-6">
			<ul class="space-y-1">
				<li>
					<a href="/dashboard" class={ getSidebarLinkClass("dashboard", currentPage) } onclick="closeMobileMenu()">
						<svg class="w-5 h-5 mr-3 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2H5a2 2 0 00-2-2z"></path>
						</svg>
						<span>Dashboard</span>
					</a>
				</li>
				<li>
					<a href="/folders" class={ getSidebarLinkClass("folders", currentPage) } onclick="closeMobileMenu()">
						<svg class="w-5 h-5 mr-3 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2H5a2 2 0 00-2-2z"></path>
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 5a2 2 0 012-2h4a2 2 0 012 2v2H8V5z"></path>
						</svg>
						<span>Folders</span>
					</a>
				</li>
				<li>
					<a href="/flashcards" class={ getSidebarLinkClass("flashcards", currentPage) } onclick="closeMobileMenu()">
						<svg class="w-5 h-5 mr-3 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path>
						</svg>
						<span>Flashcards</span>
					</a>
				</li>
				<li>
					<a href="/settings" class={ getSidebarLinkClass("settings", currentPage) } onclick="closeMobileMenu()">
						<svg class="w-5 h-5 mr-3 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"></path>
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
						</svg>
						<span>Settings</span>
					</a>
				</li>
			</ul>
		</nav>
	</aside>

	<!-- Mobile menu JavaScript -->
	<script>
		function toggleMobileMenu() {
			const sidebar = document.getElementById('sidebar');
			const overlay = document.getElementById('sidebar-overlay');

			if (sidebar.classList.contains('translate-x-0')) {
				// Close menu
				sidebar.classList.remove('translate-x-0');
				sidebar.classList.add('-translate-x-full');
				overlay.classList.add('hidden');
			} else {
				// Open menu
				sidebar.classList.remove('-translate-x-full');
				sidebar.classList.add('translate-x-0');
				overlay.classList.remove('hidden');
			}
		}

		function closeMobileMenu() {
			const sidebar = document.getElementById('sidebar');
			const overlay = document.getElementById('sidebar-overlay');
			sidebar.classList.remove('translate-x-0');
			sidebar.classList.add('-translate-x-full');
			overlay.classList.add('hidden');
		}

		// Close mobile menu when window is resized to desktop
		window.addEventListener('resize', function() {
			if (window.innerWidth >= 768) {
				closeMobileMenu();
			}
		});

		// Close mobile menu on escape key
		document.addEventListener('keydown', function(e) {
			if (e.key === 'Escape') {
				closeMobileMenu();
			}
		});
	</script>
}// Alert component
templ Alert(message, alertType string) {
	<div class={ "alert", "p-4", "rounded-md", "mb-4", getAlertClasses(alertType) }>
		{ message }
	</div>
}

// Loading spinner component
templ LoadingSpinner() {
	<div class="flex justify-center items-center p-4">
		<div class="animate-spin rounded-full h-8 w-8 border-b-2 border-indigo-600"></div>
	</div>
}

// Simple Modal component (without complex scripts)
templ Modal(id, title string) {
	<div id={ id } class="fixed inset-0 bg-gray-600 bg-opacity-50 overflow-y-auto h-full w-full hidden">
		<div class="relative top-20 mx-auto p-5 border w-96 shadow-lg rounded-md bg-white">
			<div class="mt-3">
				<div class="flex justify-between items-center mb-4">
					<h3 class="text-lg font-medium text-gray-900">{ title }</h3>
					<button data-modal-close={ id } class="text-gray-400 hover:text-gray-600">
						<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
						</svg>
					</button>
				</div>
				<div class="modal-body">
					{ children... }
				</div>
			</div>
		</div>
	</div>
}

// Folder card component - Minimalistic and fully clickable
templ FolderCard(folder models.Folder) {
	<a href={ templ.URL("/folders/" + folder.ID.String()) } class="block group">
		<div class="bg-white rounded-lg border border-gray-200 p-6 hover:border-gray-300 hover:shadow-sm transition-all duration-200 cursor-pointer">
			<div class="flex items-start justify-between mb-3">
				<h3 class="text-lg font-medium text-gray-900 truncate pr-4">{ folder.Name }</h3>
				<div class="flex space-x-1 opacity-0 group-hover:opacity-100 transition-opacity">
					<button
						onclick="event.preventDefault(); event.stopPropagation(); editFolder('{ folder.ID.String() }')"
						class="p-1 text-gray-400 hover:text-gray-600 rounded"
						title="Edit folder"
					>
						<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
						</svg>
					</button>
					<button
						onclick="event.preventDefault(); event.stopPropagation(); deleteFolder('{ folder.ID.String() }')"
						class="p-1 text-gray-400 hover:text-red-600 rounded"
						title="Delete folder"
					>
						<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
						</svg>
					</button>
				</div>
			</div>
			if folder.Description != "" {
				<p class="text-gray-600 text-sm mb-4 line-clamp-2">{ folder.Description }</p>
			}
			<div class="flex items-center justify-between text-xs text-gray-500">
				<span>{ folder.CreatedAt.Format("Jan 2, 2006") }</span>
				<svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
				</svg>
			</div>
		</div>
	</a>
}

// Content card component
templ ContentCard(content models.Content) {
	<div class="bg-white rounded-lg shadow-md p-6 hover:shadow-lg transition-shadow">
		<div class="flex items-center justify-between mb-4">
			<h3 class="text-lg font-semibold text-gray-800">{ content.Title }</h3>
			<div class="flex space-x-2">
				<button data-edit-content={ content.ID.String() } class="text-blue-600 hover:text-blue-800">
					<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
					</svg>
				</button>
				<button data-delete-content={ content.ID.String() } class="text-red-600 hover:text-red-800">
					<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
					</svg>
				</button>
			</div>
		</div>
		<p class="text-gray-600 mb-4">{ content.Description }</p>
		<div class="flex justify-between items-center text-sm text-gray-500">
			<span>{ content.ContentType }</span>
			<span>{ content.CreatedAt.Format("Jan 2, 2006") }</span>
		</div>
	</div>
}

// Helper function for alert classes
func getAlertClasses(alertType string) string {
	switch alertType {
	case "success":
		return "bg-green-100 border border-green-400 text-green-700"
	case "error":
		return "bg-red-100 border border-red-400 text-red-700"
	case "warning":
		return "bg-yellow-100 border border-yellow-400 text-yellow-700"
	default:
		return "bg-blue-100 border border-blue-400 text-blue-700"
	}
}

// Helper function for sidebar link classes
func getSidebarLinkClass(page, currentPage string) string {
	baseClasses := "flex items-center px-3 py-2 text-sm font-medium rounded-md transition-colors"
	if page == currentPage {
		return baseClasses + " bg-gray-100 text-gray-900"
	}
	return baseClasses + " text-gray-600 hover:text-gray-900 hover:bg-gray-50"
}
