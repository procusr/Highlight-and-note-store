package templates

// Base layout template
templ Layout(title string) {
	<!DOCTYPE html>
	<html lang="en">
	<head>
		<meta charset="UTF-8"/>
		<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
		<title>{ title } - MH-Go</title>
		<script src="https://cdn.tailwindcss.com"></script>
		<script src="https://unpkg.com/htmx.org@1.9.6"></script>
		<script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>
		<link rel="stylesheet" href="/static/style.css"/>
		<style>
			.line-clamp-2 {
				display: -webkit-box;
				-webkit-line-clamp: 2;
				-webkit-box-orient: vertical;
				overflow: hidden;
			}
			/* Custom transition for sidebar width */
			.sidebar-transition {
				transition: width 0.3s ease-in-out;
			}
			/* Masonry Grid Layout */
			.masonry-grid {
				columns: 2;
				column-gap: 0.75rem;
			}
			@media (min-width: 640px) {
				.masonry-grid {
					columns: 3;
					column-gap: 0.75rem;
				}
			}
			@media (min-width: 768px) {
				.masonry-grid {
					columns: 4;
					column-gap: 0.75rem;
				}
			}
			@media (min-width: 1024px) {
				.masonry-grid {
					columns: 5;
					column-gap: 0.75rem;
				}
			}
			@media (min-width: 1280px) {
				.masonry-grid {
					columns: 6;
					column-gap: 0.75rem;
				}
			}
			.masonry-item {
				break-inside: avoid;
				margin-bottom: 0.75rem;
				display: inline-block;
				width: 100%;
			}
			/* Pastel color classes */
			.pastel-pink { background: linear-gradient(135deg, #fce4ec 0%, #f8bbd9 100%); }
			.pastel-purple { background: linear-gradient(135deg, #f3e5f5 0%, #e1bee7 100%); }
			.pastel-blue { background: linear-gradient(135deg, #e3f2fd 0%, #bbdefb 100%); }
			.pastel-cyan { background: linear-gradient(135deg, #e0f2f1 0%, #b2dfdb 100%); }
			.pastel-green { background: linear-gradient(135deg, #e8f5e8 0%, #c8e6c9 100%); }
			.pastel-yellow { background: linear-gradient(135deg, #fffde7 0%, #fff9c4 100%); }
			.pastel-orange { background: linear-gradient(135deg, #fff3e0 0%, #ffcc80 100%); }
			.pastel-red { background: linear-gradient(135deg, #ffebee 0%, #ffcdd2 100%); }
			.pastel-indigo { background: linear-gradient(135deg, #e8eaf6 0%, #c5cae9 100%); }
			.pastel-teal { background: linear-gradient(135deg, #e0f2f1 0%, #b2dfdb 100%); }
			.pastel-lavender { background: linear-gradient(135deg, #f5f3ff 0%, #ddd6fe 100%); }
			.pastel-mint { background: linear-gradient(135deg, #f0fdfa 0%, #ccfbf1 100%); }
			.pastel-peach { background: linear-gradient(135deg, #fef7ed 0%, #fed7aa 100%); }
			.pastel-rose { background: linear-gradient(135deg, #fff1f2 0%, #fecaca 100%); }
			.pastel-sky { background: linear-gradient(135deg, #f0f9ff 0%, #bae6fd 100%); }
		</style>
	</head>
	<body class="bg-gray-50 min-h-screen">
		{ children... }
	</body>
	</html>
}
