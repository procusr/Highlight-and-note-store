package templates

import "fmt"

// ProgressStep renders individual step indicator in the modal
templ ProgressStep(stepNumber int, title string, currentStep int) {
	<div class="flex flex-col items-center text-sm">
		<div class="flex-shrink-0 w-8 h-8 flex items-center justify-center rounded-full text-white font-medium"
			:class={ fmt.Sprintf("step >= %d ? 'bg-[var(--color-primary)]' : 'bg-gray-300'", stepNumber) }>
			{ fmt.Sprintf("%d", stepNumber) }
		</div>
		<div class="mt-2 text-xs sm:text-sm font-medium text-center whitespace-nowrap"
			:class={ fmt.Sprintf("step >= %d ? 'text-[var(--color-primary)]' : 'text-gray-500'", stepNumber) }>
			{ title }
		</div>
	</div>
}

// ProgressStepIndicator renders the complete progress indicator with steps
templ ProgressStepIndicator() {
	<div class="mb-4 flex justify-center">
		<div class="flex items-center justify-between my-4 w-[70%]">
			@ProgressStep(1, "Subject", 1)
			@ProgressStep(2, "Goal", 2)
			@ProgressStep(3, "Method", 3)
		</div>
	</div>
}

// SubjectStep renders the first step of the modal - subject/topic selection
templ SubjectStep() {
	<div x-show="step === 1" class="space-y-4">
		<div>
			<label class="block text-sm font-medium text-gray-900 mb-2">What do you want to learn?</label>
			<input type="text"
				name="topic"
				x-model="topic"
				required
				class="w-full px-3 py-2.5 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-[var(--color-primary)] focus:border-transparent"
				placeholder="e.g., Machine Learning, Spanish"/>
		</div>
		<div class="flex justify-end">
			<button type="button"
				@click="step = 2"
				:disabled="!topic.trim()"
				class="px-5 py-2.5 text-sm font-medium text-white bg-[var(--color-primary)] border border-transparent rounded-lg hover:bg-[var(--color-primary-hover)] disabled:opacity-50 disabled:cursor-not-allowed">
				Next
			</button>
		</div>
	</div>
}

// GoalStep renders the second step of the modal - goal setting
templ GoalStep() {
	<div x-show="step === 2" class="space-y-4">
		<div>
			<label class="block text-sm font-medium text-gray-900 mb-2">What's your learning goal?</label>
			<select name="learning_goal"
				x-model="goal"
				required
				class="w-full px-3 py-2.5 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-[var(--color-primary)] focus:border-transparent">
				<option value="">Select your level...</option>
				<option value="intro">Intro - Just getting started</option>
				<option value="basics">Basics - Learn fundamental concepts</option>
				<option value="intermediate">Intermediate - Build on existing knowledge</option>
				<option value="mastery">Mastery - Achieve expert-level understanding</option>
			</select>
		</div>
		<div class="flex justify-between">
			<button type="button"
				@click="step = 1"
				class="px-5 py-2.5 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-lg hover:bg-gray-50">
				Back
			</button>
			<button type="button"
				@click="step = 3"
				:disabled="!goal"
				class="px-5 py-2.5 text-sm font-medium text-white bg-[var(--color-primary)] border border-transparent rounded-lg hover:bg-[var(--color-primary-hover)] disabled:opacity-50 disabled:cursor-not-allowed">
				Next
			</button>
		</div>
	</div>
}

// MethodStep renders the third step of the modal - method selection
templ MethodStep() {
	<div x-show="step === 3" class="space-y-4">
		<div>
			<label class="block text-sm font-medium text-gray-900 mb-3">Choose your learning style</label>
			<div class="space-y-3">
				<template x-for="method in availableMethods" :key="method.key">
					<div class="border border-gray-200 rounded-lg p-4 cursor-pointer hover:border-gray-300 transition-colors"
						:class="{ 'border-gray-900 bg-gray-50': selectedMethod === method.key }"
						@click="selectedMethod = method.key">
						<div class="flex items-start">
							<input type="radio"
								name="method_key"
								:value="method.key"
								:checked="selectedMethod === method.key"
								class="mt-1 mr-3"
								required>
							<div class="flex-1">
								<h4 class="font-medium text-gray-900 text-sm mb-1" x-text="method.name"></h4>
								<p class="text-xs text-gray-600" x-text="method.description"></p>
							</div>
						</div>
					</div>
				</template>
			</div>
		</div>
		<div class="flex justify-between">
			<button type="button"
				@click="step = 2"
				class="px-5 py-2.5 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-lg hover:bg-gray-50">
				Back
			</button>
			<button type="submit"
				:disabled="!selectedMethod"
				class="px-5 py-2.5 text-sm font-medium text-white bg-[var(--color-primary)] border border-transparent rounded-lg hover:bg-[var(--color-primary-hover)] disabled:opacity-50 disabled:cursor-not-allowed">
				Start Learning
			</button>
		</div>
	</div>
}

// NewLearningSessionModal renders the complete modal for creating a new learning session
templ NewLearningSessionModal() {
	<div x-show="showModal"
		class="fixed inset-0 z-50 flex items-center justify-center p-4"
		style="display: none;">
		<div class="fixed inset-0 bg-black bg-opacity-50" @click="showModal = false"></div>

		<div class="relative bg-white rounded-lg p-6 max-w-md w-full max-h-[90vh] overflow-y-auto">
			<button @click="showModal = false" class="absolute top-4 right-4 text-gray-400 hover:text-gray-600">
				<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
				</svg>
			</button>

			<!-- Progress Steps -->
			@ProgressStepIndicator()


			<form hx-post="/learning/start" hx-target="#learning-result" @submit.prevent="$el.querySelector('button[type=submit]').disabled = true; htmx.process($el); setTimeout(() => showModal = false, 500)">
				<!-- Step 1: Subject -->
				@SubjectStep()

				<!-- Step 2: Goal -->
				@GoalStep()

				<!-- Step 3: Learning Method -->
				@MethodStep()


			</form>
		</div>
	</div>
}