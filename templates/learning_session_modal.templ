package templates

import "fmt"

// ProgressStep renders individual step indicator in the modal
templ ProgressStep(stepNumber int, title string, currentStep int) {
	<div class="flex flex-col items-center text-sm min-w-0">
		<div class="flex-shrink-0 w-8 h-8 flex items-center justify-center rounded-full text-white font-medium"
			:class={ fmt.Sprintf("step >= %d ? 'bg-[var(--color-primary)]' : 'bg-gray-300'", stepNumber) }>
			{ fmt.Sprintf("%d", stepNumber) }
		</div>
		<div class="mt-2 text-[10px] sm:text-xs font-medium text-center whitespace-nowrap"
			:class={ fmt.Sprintf("step >= %d ? 'text-[var(--color-primary)]' : 'text-gray-500'", stepNumber) }>
			{ title }
		</div>
	</div>
}

// ProgressStepIndicator renders the complete progress indicator with steps
templ ProgressStepIndicator() {
	<div class="mb-4 flex justify-center">
		<div class="flex flex-row items-center justify-between my-4 w-[85%] sm:w-[70%]">
			@ProgressStep(1, "Subject", 1)
			@ProgressStep(2, "Goal", 2)
			@ProgressStep(3, "Method", 3)
		</div>
	</div>
}

// SubjectStep renders the first step of the modal - subject/topic selection
templ SubjectStep() {
	<div x-show="step === 1" class="space-y-4">
		<div>
			<label class="block text-sm font-medium text-gray-900 mb-2">What do you want to learn?</label>
			<input type="text"
				name="topic"
				x-model="topic"
				required
				class="w-full px-3 py-2.5 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-[var(--color-primary)] focus:border-transparent"
				placeholder="e.g., Machine Learning, Spanish"/>
		</div>
		<div class="flex justify-end">
			<button type="button"
				@click="step = 2"
				:disabled="!topic.trim()"
				class="px-4 sm:px-5 py-2.5 text-sm font-medium text-white bg-[var(--color-primary)] border border-transparent rounded-lg hover:bg-[var(--color-primary-hover)] disabled:opacity-50 disabled:cursor-not-allowed whitespace-nowrap">
				Next
			</button>
		</div>
	</div>
}

// GoalStep renders the second step of the modal - goal setting
templ GoalStep() {
	<div x-show="step === 2" class="space-y-4">
		<div>
			<label class="block text-sm font-medium text-gray-900 mb-2">What's your learning goal?</label>
			<select name="learning_goal"
				x-model="goal"
				required
				class="w-full px-3 py-2.5 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-[var(--color-primary)] focus:border-transparent">
				<option value="">Select your level...</option>
				<option value="intro">Intro - Just getting started</option>
				<option value="basics">Basics - Learn fundamental concepts</option>
				<option value="intermediate">Intermediate - Build on existing knowledge</option>
				<option value="mastery">Mastery - Achieve expert-level understanding</option>
			</select>
		</div>
		<div class="flex justify-between gap-2">
			<button type="button"
				@click="step = 1"
				class="px-4 sm:px-5 py-2.5 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-lg hover:bg-gray-50 whitespace-nowrap">
				Back
			</button>
			<button type="button"
				@click="step = 3"
				:disabled="!goal"
				class="px-4 sm:px-5 py-2.5 text-sm font-medium text-white bg-[var(--color-primary)] border border-transparent rounded-lg hover:bg-[var(--color-primary-hover)] disabled:opacity-50 disabled:cursor-not-allowed whitespace-nowrap">
				Next
			</button>
		</div>
	</div>
}

// MethodStep renders the third step of the modal - method selection
templ MethodStep() {
	<div x-show="step === 3" class="space-y-4">
		<div>
			<label class="block text-sm font-medium text-gray-900 mb-3">Choose your learning style</label>
			<div class="space-y-3">
				<!-- Method: Applied Mastery Laboratory -->
				<div class="border-2 rounded-lg p-3 sm:p-4 cursor-pointer transition-all"
					:class="selectedMethod === 'applied_laboratory' ? 'border-[var(--color-primary)] bg-gradient-to-br from-blue-50 to-purple-50 shadow-sm' : 'border-gray-200 bg-white hover:border-gray-300 hover:shadow-sm'"
					@click="selectedMethod = 'applied_laboratory'">
					<input type="radio" name="method_key" value="applied_laboratory" :checked="selectedMethod === 'applied_laboratory'" class="hidden" required>
					<div>
						<h4 class="font-medium text-gray-900 text-sm mb-1">Applied Mastery Laboratory</h4>
						<p class="text-xs text-gray-600">Hands-on practice and real-world application of concepts through experiments and projects.</p>
					</div>
				</div>

				<!-- Method: Foundation Through Discovery -->
				<div class="border-2 rounded-lg p-3 sm:p-4 cursor-pointer transition-all"
					:class="selectedMethod === 'foundation_discovery' ? 'border-[var(--color-primary)] bg-gradient-to-br from-blue-50 to-purple-50 shadow-sm' : 'border-gray-200 bg-white hover:border-gray-300 hover:shadow-sm'"
					@click="selectedMethod = 'foundation_discovery'">
					<input type="radio" name="method_key" value="foundation_discovery" :checked="selectedMethod === 'foundation_discovery'" class="hidden" required>
					<div>
						<h4 class="font-medium text-gray-900 text-sm mb-1">Foundation Through Discovery</h4>
						<p class="text-xs text-gray-600">Explore and discover fundamental concepts through guided inquiry and investigation.</p>
					</div>
				</div>

				<!-- Method: Integration & Transfer System -->
				<div class="border-2 rounded-lg p-3 sm:p-4 cursor-pointer transition-all"
					:class="selectedMethod === 'integration_transfer' ? 'border-[var(--color-primary)] bg-gradient-to-br from-blue-50 to-purple-50 shadow-sm' : 'border-gray-200 bg-white hover:border-gray-300 hover:shadow-sm'"
					@click="selectedMethod = 'integration_transfer'">
					<input type="radio" name="method_key" value="integration_transfer" :checked="selectedMethod === 'integration_transfer'" class="hidden" required>
					<div>
						<h4 class="font-medium text-gray-900 text-sm mb-1">Integration & Transfer System</h4>
						<p class="text-xs text-gray-600">Connect knowledge across domains and apply learning to new contexts and situations.</p>
					</div>
				</div>

				<!-- Method: Mistake-Based Learning Lab -->
				<div class="border-2 rounded-lg p-3 sm:p-4 cursor-pointer transition-all"
					:class="selectedMethod === 'mistake_learning_lab' ? 'border-[var(--color-primary)] bg-gradient-to-br from-blue-50 to-purple-50 shadow-sm' : 'border-gray-200 bg-white hover:border-gray-300 hover:shadow-sm'"
					@click="selectedMethod = 'mistake_learning_lab'">
					<input type="radio" name="method_key" value="mistake_learning_lab" :checked="selectedMethod === 'mistake_learning_lab'" class="hidden" required>
					<div>
						<h4 class="font-medium text-gray-900 text-sm mb-1">Mistake-Based Learning Lab</h4>
						<p class="text-xs text-gray-600">Learn from errors and develop resilience through controlled failure analysis and correction.</p>
					</div>
				</div>

				<!-- Method: Problem-Solving Gymnasium -->
				<div class="border-2 rounded-lg p-3 sm:p-4 cursor-pointer transition-all"
					:class="selectedMethod === 'problem_gymnasium' ? 'border-[var(--color-primary)] bg-gradient-to-br from-blue-50 to-purple-50 shadow-sm' : 'border-gray-200 bg-white hover:border-gray-300 hover:shadow-sm'"
					@click="selectedMethod = 'problem_gymnasium'">
					<input type="radio" name="method_key" value="problem_gymnasium" :checked="selectedMethod === 'problem_gymnasium'" class="hidden" required>
					<div>
						<h4 class="font-medium text-gray-900 text-sm mb-1">Problem-Solving Gymnasium</h4>
						<p class="text-xs text-gray-600">Build critical thinking skills through structured problem-solving exercises and challenges.</p>
					</div>
				</div>
			</div>
		</div>
		<div class="flex justify-between gap-2">
			<button type="button"
				@click="step = 2"
				class="px-4 sm:px-5 py-2.5 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-lg hover:bg-gray-50 whitespace-nowrap">
				Back
			</button>
			<button type="submit"
				:disabled="!selectedMethod"
				class="px-4 sm:px-5 py-2.5 text-sm font-medium text-white bg-[var(--color-primary)] border border-transparent rounded-lg hover:bg-[var(--color-primary-hover)] disabled:opacity-50 disabled:cursor-not-allowed whitespace-nowrap">
				Start Learning
			</button>
		</div>
	</div>
}

// NewLearningSessionModal renders the complete modal for creating a new learning session
templ NewLearningSessionModal() {
	<div x-show="showModal"
		class="fixed inset-0 z-50 flex items-center justify-center p-4"
		style="display: none;">
		<div class="fixed inset-0 bg-black bg-opacity-50" @click="showModal = false"></div>

		<div class="relative bg-white rounded-lg max-w-md w-full max-h-[90vh] flex flex-col">
			<!-- Sticky Header with Close Button -->
			<div class="sticky top-0 bg-white rounded-t-lg z-10 px-6 pt-6 pb-2">
				<button @click="showModal = false" class="absolute top-4 right-4 text-gray-400 hover:text-gray-600 z-20">
					<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
					</svg>
				</button>

				<!-- Progress Steps -->
				@ProgressStepIndicator()
			</div>

			<!-- Scrollable Form Content -->
			<div class="flex-1 overflow-y-auto px-6 pb-6">
				<form hx-post="/learning/start" hx-target="#learning-result" @submit.prevent="$el.querySelector('button[type=submit]').disabled = true; htmx.process($el); setTimeout(() => showModal = false, 500)">
					<!-- Step 1: Subject -->
					@SubjectStep()

					<!-- Step 2: Goal -->
					@GoalStep()

					<!-- Step 3: Learning Method -->
					@MethodStep()
				</form>
			</div>
		</div>
	</div>
}