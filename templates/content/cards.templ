package templates

import (
	"mh-go/internal/models"
	"strings"
)

// Folder card component - Masonry style with random pastel colors
templ FolderCard(folder models.Folder) {
	<div class="masonry-item">
		<a href={ templ.URL("/folders/" + folder.ID.String()) } class="block group">
			if folder.IsFrontDesk() {
				<div class="rounded-lg border-2 border-amber-400 bg-gradient-to-br from-amber-50 to-orange-100 hover:from-amber-100 hover:to-orange-200 hover:border-amber-500 hover:shadow-lg transition-all duration-200 cursor-pointer overflow-hidden relative">
					<!-- Front Desk Badge -->
					<div class="absolute top-2 right-2 z-10">
						<span class="inline-flex items-center px-2 py-1 rounded-full text-xs font-medium bg-amber-500 text-white">
							<svg class="w-3 h-3 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"></path>
							</svg>
							Front Desk
						</span>
					</div>
					@FolderCardContent(folder)
				</div>
			} else {
				<div class={ "rounded-lg border border-gray-200 hover:border-gray-300 hover:shadow-md transition-all duration-200 cursor-pointer overflow-hidden", getPastelColor(folder.ID.String()) }>
					@FolderCardContent(folder)
				</div>
			}
		</a>
	</div>
}

// Shared folder card content
templ FolderCardContent(folder models.Folder) {
	<!-- Card Header with gradient overlay -->
	<div class="relative p-3 md:p-4">
		if folder.IsFrontDesk() {
			<div class="absolute inset-0 bg-white/30 backdrop-blur-sm"></div>
		} else {
			<div class="absolute inset-0 bg-white/20 backdrop-blur-sm"></div>
		}
		<div class="relative">
			<div class="flex items-start justify-between mb-2">
				if folder.IsFrontDesk() {
					<h3 class="text-sm md:text-base font-semibold text-amber-900 truncate pr-12 leading-tight">{ folder.Name }</h3>
				} else {
					<h3 class="text-sm md:text-base font-medium text-gray-800 truncate pr-2 leading-tight">{ folder.Name }</h3>
				}
				if folder.IsEditable() || folder.IsDeletable() {
					<div class="flex space-x-1 opacity-0 group-hover:opacity-100 transition-opacity duration-200">
						if folder.IsEditable() {
							<button
								data-folder-id={ folder.ID.String() }
								data-folder-name={ folder.Name }
								data-folder-description={ folder.Description }
								onclick="event.preventDefault(); event.stopPropagation(); showEditFolderModal(this.dataset.folderId, this.dataset.folderName, this.dataset.folderDescription)"
								class="p-1 text-gray-600 hover:text-gray-800 hover:bg-white/50 rounded transition-colors"
								title="Edit folder"
							>
								<svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
								</svg>
							</button>
						}
						if folder.IsDeletable() {
							<button
								data-folder-id={ folder.ID.String() }
								data-folder-name={ folder.Name }
								onclick="event.preventDefault(); event.stopPropagation(); showDeleteFolderModal(this.dataset.folderId, this.dataset.folderName)"
								class="p-1 text-gray-600 hover:text-red-600 hover:bg-white/50 rounded transition-colors"
								title="Delete folder"
							>
								<svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
								</svg>
							</button>
						}
					</div>
				}
			</div>

			if folder.Description != "" {
				<div class={ "mb-3", getContentHeight(folder.Description) }>
					if folder.IsFrontDesk() {
						<p class="text-amber-800 text-xs md:text-sm leading-relaxed">{ folder.Description }</p>
					} else {
						<p class="text-gray-700 text-xs md:text-sm leading-relaxed">{ folder.Description }</p>
					}
				</div>
			}

			<!-- Folder icon and date -->
			<div class="flex items-center justify-between">
				<div class="flex items-center space-x-1.5">
					<div class="p-1.5 bg-white/30 rounded">
						if folder.IsFrontDesk() {
							<svg class="w-3 h-3 md:w-4 md:h-4 text-amber-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path>
							</svg>
						} else {
							<svg class="w-3 h-3 md:w-4 md:h-4 text-gray-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2H5a2 2 0 00-2-2z"></path>
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 5a2 2 0 012-2h4a2 2 0 012 2v2H8V5z"></path>
							</svg>
						}
					</div>
					if folder.IsFrontDesk() {
						<span class="text-xs text-amber-700 font-medium">{ folder.CreatedAt.Format("Jan 2") }</span>
					} else {
						<span class="text-xs text-gray-600 font-medium">{ folder.CreatedAt.Format("Jan 2") }</span>
					}
				</div>
				<div class="opacity-60 group-hover:opacity-100 transition-opacity">
					if folder.IsFrontDesk() {
						<svg class="w-3 h-3 md:w-4 md:h-4 text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
						</svg>
					} else {
						<svg class="w-3 h-3 md:w-4 md:h-4 text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
						</svg>
					}
				</div>
			</div>
		</div>
	</div>
}

// Content card component - Using native HTML details/summary for exclusive accordions
templ ContentCard(content models.Content) {
	<details name="content-accordion" class="w-full max-w-[70ch] bg-white rounded-lg shadow-md hover:shadow-lg transition-shadow border border-gray-200 mb-4">
		<summary class="p-4 cursor-pointer hover:bg-gray-50 transition-colors list-none">
			<div class="flex items-center justify-between gap-2">
				<div class="flex-1 pr-2 min-w-0">
					<!-- Main heading - Question, Title, or placeholder -->
					<h3 class="text-lg font-semibold text-gray-900 leading-snug mb-2 main-heading break-words">
						if content.Question != "" {
							{ content.Question }
						} else if content.Title != "" {
							{ content.Title }
						} else {
							{ deriveBodySnippet(content.Body) }
						}
					</h3>

					<!-- Content metadata -->
					<div class="flex items-center gap-2 text-sm text-gray-500">
						<span class="whitespace-nowrap text-xs tracking-wide uppercase text-gray-400">{ content.CreatedAt.Format("Jan 2, 2006") }</span>
					</div>
				</div>
				<!-- Chevron -->
				<div class="flex-shrink-0 self-start pt-1">
					<svg class="w-5 h-5 text-gray-400 transform transition-transform duration-200 details-chevron" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
					</svg>
				</div>
			</div>
		</summary>

		<!-- Details content -->
		<div class="border-t border-gray-200">
			<div class="p-4 bg-gray-50">
				<div class="answer-content">
					if content.ContentType == "markdown" {
						<div class="prose prose-base max-w-none">
							<div class="whitespace-pre-wrap text-gray-800 leading-relaxed text-[0.95rem]">{ content.Body }</div>
						</div>
					} else if content.ContentType == "link" {
						<div class="flex items-center space-x-2 p-3 bg-[var(--color-feature-blue)] rounded-lg">
							<svg class="w-4 h-4 text-[var(--color-feature-blue-text)]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v7a2 2 0 002 2h4m-4-9a2 2 0 012-2h4"></path>
							</svg>
							<a href={ templ.URL(content.Body) } target="_blank" rel="noopener noreferrer" class="text-[var(--color-feature-blue-text)] hover:text-blue-800 underline break-all text-sm">
								{ content.Body }
							</a>
						</div>
					} else {
						<div class="bg-white p-3 rounded-lg border">
							<pre class="whitespace-pre-wrap text-sm text-gray-800 font-mono leading-relaxed">{ content.Body }</pre>
						</div>
					}
				</div>
			</div>

			<!-- Action buttons in expanded state -->
			<div class="px-4 py-4 bg-white border-t border-gray-200 flex justify-end flex-wrap gap-3">
				<button
					data-edit-content={ content.ID.String() }
					class="inline-flex items-center px-4 py-2 text-sm font-medium text-[var(--color-feature-blue-text)] hover:text-blue-800 hover:bg-[var(--color-feature-blue)] rounded-md transition-colors edit-content-btn"
				>
					<svg class="w-3 h-3 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
					</svg>
					Edit
				</button>
				<button
					data-delete-content={ content.ID.String() }
					data-content-title={ content.Title }
					class="inline-flex items-center px-4 py-2 text-sm font-medium text-[var(--color-feature-red-text)] hover:text-red-800 hover:bg-[var(--color-feature-red)] rounded-md transition-colors delete-content-btn"
				>
					<svg class="w-3 h-3 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
					</svg>
					Delete
				</button>
			</div>
		</div>
	</details>
}

// Helper function to get random pastel color based on folder ID
func getPastelColor(folderID string) string {
	colors := []string{
		"pastel-pink", "pastel-purple", "pastel-blue", "pastel-cyan", "pastel-green",
		"pastel-yellow", "pastel-orange", "pastel-red", "pastel-indigo", "pastel-teal",
		"pastel-lavender", "pastel-mint", "pastel-peach", "pastel-rose", "pastel-sky",
	}

	// Use a simple hash of the folder ID to get consistent color per folder
	hash := 0
	for _, char := range folderID {
		hash = int(char) + ((hash << 5) - hash)
	}
	if hash < 0 {
		hash = -hash
	}

	return colors[hash%len(colors)]
}

// Helper function to determine content height based on description length
func getContentHeight(description string) string {
	if len(description) == 0 {
		return ""
	}

	// Vary height based on content length to create masonry effect (smaller sizes)
	switch {
	case len(description) > 200:
		return "min-h-[80px]"
	case len(description) > 100:
		return "min-h-[60px]"
	case len(description) > 50:
		return "min-h-[40px]"
	default:
		return "min-h-[30px]"
	}
}

// deriveBodySnippet returns a short snippet to use as a fallback heading
func deriveBodySnippet(body string) string {
	trimmed := strings.TrimSpace(body)
	if trimmed == "" {
		return "(Empty Content)"
	}
	// Take first non-empty line
	line := ""
	for _, l := range strings.Split(trimmed, "\n") {
		l = strings.TrimSpace(l)
		if l != "" {
			line = l
			break
		}
	}
	if line == "" {
		line = trimmed
	}
	runes := []rune(line)
	limit := 80
	if len(runes) > limit {
		line = string(runes[:limit]) + "…"
	}
	return line
}