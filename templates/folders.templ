package templates

import "mh-go/internal/models"

// Folder view page
templ FolderPage(user *models.User, folder models.Folder, contents []models.Content, subfolders []models.Folder) {
	@Layout("Folder: " + folder.Name) {
		@Sidebar("folder", user)
		<main class="pt-16 md:pt-6 pb-6">
			<div class="main-container">
			<!-- Breadcrumb -->
			<nav class="flex mb-6" aria-label="Breadcrumb">
				<ol class="inline-flex items-center space-x-1 md:space-x-3">
					<li class="inline-flex items-center">
						<a href="/overview" class="text-gray-700 hover:text-gray-900">
							Overview
						</a>
					</li>
					<li>
						<div class="flex items-center">
							<svg class="w-6 h-6 text-gray-400" fill="currentColor" viewBox="0 0 20 20">
								<path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"></path>
							</svg>
							<span class="text-gray-500 ml-1 md:ml-2">{ folder.Name }</span>
						</div>
					</li>
				</ol>
			</nav>

			<!-- Folder Header -->
			<header class="mb-10">
				<div class="flex flex-col md:flex-row md:items-end md:justify-between gap-6">
					<div class="flex-1 min-w-0">
						<h1 class="text-3xl font-semibold tracking-tight text-gray-900 mb-2 break-words">{ folder.Name }</h1>
						if folder.Description != "" {
							<p class="text-gray-600 leading-relaxed max-w-prose text-sm md:text-base">{ folder.Description }</p>
						}
					</div>
					<div class="flex items-center gap-3">
						<button
							onclick="showCreateContentModal()"
							class="inline-flex items-center px-5 py-2.5 rounded-md bg-[var(--color-primary)] hover:bg-[var(--color-primary-hover)] text-white text-sm font-medium shadow-sm focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-[var(--color-primary)] transition"
						>
							<svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
							New Content
						</button>
					</div>
				</div>
			</header>

			<!-- Subfolders -->
			if len(subfolders) > 0 {
				<div class="mb-8">
					<h2 class="text-lg font-semibold text-gray-900 mb-4">Folders</h2>
					<div class="masonry-grid">
						for _, subfolder := range subfolders {
							@FolderCard(subfolder)
						}
					</div>
				</div>
			}

			<!-- Content Section -->
			<section aria-labelledby="content-heading" class="mb-4">
				<h2 id="content-heading" class="text-xs font-semibold tracking-wide text-gray-500 uppercase mb-3">Content</h2>
				<div id="content-container" class="flex flex-col gap-3">
					for _, content := range contents {
						@ContentCard(content)
					}
				</div>
			</section>

			if len(subfolders) == 0 && len(contents) == 0 {
				<div class="text-center py-16 border-2 border-dashed border-gray-200 rounded-lg bg-white">
					<svg class="mx-auto h-12 w-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 2a1 1 0 000 2h6a1 1 0 100-2H9z"></path>
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path>
					</svg>
					<h3 class="mt-4 text-base font-medium text-gray-900">No items yet</h3>
					<p class="mt-2 text-sm text-gray-500">Start by adding your first note or creating a subfolder.</p>
					<button onclick="showCreateContentModal()" class="mt-6 inline-flex items-center px-4 py-2 rounded-md bg-[var(--color-primary)] hover:bg-[var(--color-primary-hover)] text-white text-sm font-medium shadow focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-[var(--color-primary)] transition">Create Content</button>
				</div>
			}
			</div>
		</main>

		<!-- Create Content Modal -->
		@CreateContentModal(folder.ID.String())

		<!-- Edit Content Modal Container -->
		<div id="editContentModalContainer"></div>

		<!-- View Content Modal Container -->
		<div id="viewContentModalContainer"></div>

		<!-- Delete Content Modal -->
		<div id="deleteContentModal" class="fixed inset-0 bg-gray-600 bg-opacity-50 overflow-y-auto h-full w-full hidden z-50">
			<div class="relative top-20 mx-auto p-5 border w-96 shadow-lg rounded-md bg-white">
				<div class="mt-3">
					<div class="flex justify-between items-center mb-4">
						<h3 class="text-lg font-medium text-gray-900">Delete Content</h3>
						<button onclick="closeModal('deleteContentModal')" class="text-gray-400 hover:text-gray-600">
							<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
							</svg>
						</button>
					</div>
					<div class="modal-body">
						<div class="mb-4">
							<div class="flex items-center mb-4">
								<div class="mx-auto flex-shrink-0 flex items-center justify-center h-12 w-12 rounded-full bg-red-100">
									<svg class="h-6 w-6 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L3.732 16.5c-.77.833.192 2.5 1.732 2.5z"></path>
									</svg>
								</div>
							</div>
							<div class="text-center">
								<h3 class="text-lg font-medium text-gray-900 mb-2">Delete Content</h3>
								<p class="text-sm text-gray-500 mb-4">Are you sure you want to delete this content? This action cannot be undone.</p>
								<p class="text-sm font-medium text-gray-900" id="contentTitleToDelete"></p>
							</div>
						</div>
						<div class="flex justify-end space-x-3">
							<button
								type="button"
								onclick="closeModal('deleteContentModal')"
								class="px-4 py-2 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50"
							>
								Cancel
							</button>
							<button
								type="button"
								id="confirmDeleteContent"
								class="px-4 py-2 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-red-600 hover:bg-red-700 transition-colors"
							>
								Delete Content
							</button>
						</div>
					</div>
				</div>
			</div>
		</div>

		<!-- JavaScript for modal functionality -->
		<script>
			document.addEventListener('DOMContentLoaded', function() {
				// Show create content modal
				window.showCreateContentModal = function() {
					document.getElementById('createContentModal').classList.remove('hidden');
				};

				// Close modal by ID
				window.closeModal = function(modalId) {
					document.getElementById(modalId).classList.add('hidden');
				};

				// Handle modal close buttons
				document.addEventListener('click', function(e) {
					if (e.target.hasAttribute('data-modal-close')) {
						const modalId = e.target.getAttribute('data-modal-close');
						closeModal(modalId);
					}
				});

				// Close modal when clicking outside
				document.addEventListener('click', function(e) {
					const modal = document.getElementById('createContentModal');
					if (e.target === modal) {
						closeModal('createContentModal');
					}
				});

				// Content management functions
				window.showEditContentModal = function(contentId) {
					// Load the edit modal with the content data
					fetch(`/api/content/${contentId}/edit`)
						.then(response => {
							if (!response.ok) {
								throw new Error(`HTTP error! status: ${response.status}`);
							}
							return response.text();
						})
						.then(html => {
							document.getElementById('editContentModalContainer').innerHTML = html;
							// The modal should now be in the DOM, try to show it
							const modal = document.getElementById('editContentModal');
							if (modal) {
								modal.classList.remove('hidden');
							} else {
								console.error('Edit content modal not found in returned HTML');
							}
						})
						.catch(error => {
							console.error('Error loading edit content modal:', error);
							alert('Failed to load edit form. Please try again.');
						});
				};

				window.showDeleteContentModal = function(contentId, contentTitle) {
					document.getElementById('contentTitleToDelete').textContent = contentTitle;
					document.getElementById('deleteContentModal').classList.remove('hidden');

					// Remove any existing event listeners to prevent duplicates
					const confirmButton = document.getElementById('confirmDeleteContent');
					const newConfirmButton = confirmButton.cloneNode(true);
					confirmButton.parentNode.replaceChild(newConfirmButton, confirmButton);

					// Set up the delete confirmation
					newConfirmButton.addEventListener('click', function() {
						// Disable button to prevent multiple clicks
						newConfirmButton.disabled = true;
						newConfirmButton.textContent = 'Deleting...';

						// Make delete request
						fetch(`/api/content/${contentId}`, {
							method: 'DELETE',
							headers: {
								'HX-Request': 'true'
							}
						})
						.then(response => {
							if (response.ok) {
								// Close modal first
								closeModal('deleteContentModal');
								// Reload the page to show updated content list
								window.location.reload();
							} else {
								return response.text().then(text => {
									throw new Error(text || 'Failed to delete content');
								});
							}
						})
						.catch(error => {
							console.error('Error deleting content:', error);
							alert('Error deleting content: ' + error.message);
							// Re-enable button on error
							newConfirmButton.disabled = false;
							newConfirmButton.textContent = 'Delete Content';
						});
					});
				};

				// View content modal function
				window.showViewContentModal = function(contentId) {
					// Load the view modal with the content data
					fetch(`/api/content/${contentId}/view`)
						.then(response => {
							if (!response.ok) {
								throw new Error(`HTTP error! status: ${response.status}`);
							}
							return response.text();
						})
						.then(html => {
							document.getElementById('viewContentModalContainer').innerHTML = html;
							// The modal should now be in the DOM, try to show it
							const modal = document.getElementById('viewContentModal');
							if (modal) {
								modal.classList.remove('hidden');

								// If content is markdown, we can enhance it with a markdown parser if needed
								const markdownContent = modal.querySelector('#markdown-content');
								if (markdownContent && markdownContent.textContent.trim()) {
									// For now, just preserve whitespace and basic formatting
									// In the future, we could add a markdown parser like marked.js
									markdownContent.style.whiteSpace = 'pre-wrap';
								}
							} else {
								console.error('View content modal not found in returned HTML');
							}
						})
						.catch(error => {
							console.error('Error loading view content modal:', error);
							alert('Failed to load content. Please try again.');
						});
				};


				// Handle content card interactions (edit/delete)
				document.addEventListener('click', function(e) {
					// Handle edit button clicks
					if (e.target.closest('.edit-content-btn')) {
						e.preventDefault();
						e.stopPropagation();
						const button = e.target.closest('.edit-content-btn');
						const contentId = button.getAttribute('data-edit-content');
						showEditContentModal(contentId);
					}

					// Handle delete button clicks
					if (e.target.closest('.delete-content-btn')) {
						e.preventDefault();
						e.stopPropagation();
						const button = e.target.closest('.delete-content-btn');
						const contentId = button.getAttribute('data-delete-content');
						const contentTitle = button.getAttribute('data-content-title') || 'this content';
						showDeleteContentModal(contentId, contentTitle);
					}

					// Legacy support for old data attributes (if any still exist)
					if (e.target.closest('[data-edit-content]') && !e.target.closest('.edit-content-btn')) {
						e.preventDefault();
						e.stopPropagation();
						const button = e.target.closest('[data-edit-content]');
						const contentId = button.getAttribute('data-edit-content');
						showEditContentModal(contentId);
					}

					if (e.target.closest('[data-delete-content]') && !e.target.closest('.delete-content-btn')) {
						e.preventDefault();
						e.stopPropagation();
						const button = e.target.closest('[data-delete-content]');
						const contentId = button.getAttribute('data-delete-content');
						const contentTitle = button.getAttribute('data-content-title') || 'this content';
						showDeleteContentModal(contentId, contentTitle);
					}
				});
			});
		</script>

		<style>
			/* Native details/summary styling for accordions */
			details[name="content-accordion"] {
				border: 1px solid #e5e7eb;
				border-radius: 0.5rem;
				background: white;
				margin-bottom: 1rem;
				box-shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.1), 0 1px 2px 0 rgba(0, 0, 0, 0.06);
				transition: box-shadow 0.15s ease-in-out;
				width: 100%;
			}

			details[name="content-accordion"]:hover {
				box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
			}

			details[name="content-accordion"] summary {
				cursor: pointer;
				padding: 1rem;
				background: white;
				border-radius: 0.5rem;
				transition: background-color 0.15s ease-in-out;
				list-style: none; /* Remove default marker */
			}

			details[name="content-accordion"] summary:hover {
				background-color: #f9fafb;
			}

			/* Hide default details marker */
			details[name="content-accordion"] summary::-webkit-details-marker {
				display: none;
			}

			/* Custom chevron rotation */
			details[name="content-accordion"][open] .details-chevron {
				transform: rotate(180deg);
			}

			.details-chevron {
				transition: transform 0.2s ease-in-out;
			}

			/* Full width container for content cards */
			.content-card-container {
				width: 100%;
			}
		</style>
	}
}

// Folders page
templ FoldersPage(user *models.User, folders []models.Folder) {
	@Layout("Folders") {
		@Sidebar("folders", user)

		<main class="pt-16 md:pt-6 pb-6">
			<div class="main-container">
				<div class="mb-6 md:mb-8">
					<div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
						<div>
							<h1 class="text-xl md:text-2xl font-semibold text-gray-900 mb-2">All Folders</h1>
							<p class="text-gray-600 text-sm md:text-base">Organize your content into folders for easy management.</p>
						</div>
						<button
							onclick="showCreateFolderModal()"
							class="inline-flex items-center px-3 md:px-4 py-2 text-xs md:text-sm font-medium text-white bg-[var(--color-primary)] border border-transparent rounded-md hover:bg-[var(--color-primary-hover)] transition-colors"
						>
							<svg class="w-3 h-3 md:w-4 md:h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
							</svg>
							New Folder
						</button>
					</div>
				</div>

				if len(folders) > 0 {
					<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-3 md:gap-4" id="folders-container">
						for _, folder := range folders {
							@FolderCard(folder)
						}
					</div>
				} else {
					<div class="text-center py-12 md:py-16" id="folders-container">
						<div class="mx-auto w-12 h-12 md:w-16 md:h-16 bg-gray-100 rounded-full flex items-center justify-center mb-4">
							<svg class="h-6 w-6 md:h-8 md:w-8 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2H5a2 2 0 00-2-2z"></path>
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 5a2 2 0 012-2h4a2 2 0 012 2v2H8V5z"></path>
							</svg>
						</div>
						<h3 class="text-base md:text-lg font-medium text-gray-900 mb-2">No folders yet</h3>
						<p class="text-gray-600 text-sm md:text-base px-4 mb-6">Get started by creating your first folder to organize your content.</p>
						<button
							onclick="showCreateFolderModal()"
							class="inline-flex items-center px-4 py-2 text-sm font-medium text-white bg-[var(--color-primary)] border border-transparent rounded-md hover:bg-[var(--color-primary-hover)] transition-colors"
						>
							<svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
							</svg>
							Create Your First Folder
						</button>
					</div>
				}
			</div>
		</main>

		<!-- Create Folder Modal -->
		@CreateFolderModal()

		<!-- Edit Folder Modal -->
		<div id="editFolderModalContainer"></div>

		<!-- Delete Folder Modal -->
		@DeleteFolderModal()

		<!-- JavaScript for modal functionality -->
		<script>
			// Simple modal management
			document.addEventListener('DOMContentLoaded', function() {
				// Show create folder modal
				window.showCreateFolderModal = function() {
					document.getElementById('createFolderModal').classList.remove('hidden');
				}

				// Close modal by ID
				window.closeModal = function(modalId) {
					document.getElementById(modalId).classList.add('hidden');
				}

				// Handle modal close buttons
				document.addEventListener('click', function(e) {
					if (e.target.hasAttribute('data-modal-close')) {
						const modalId = e.target.getAttribute('data-modal-close');
						closeModal(modalId);
					}
				});

				// Close modal when clicking outside
				window.onclick = function(event) {
					const modal = document.getElementById('createFolderModal');
					if (event.target === modal) {
						modal.classList.add('hidden');
					}
				}

				// Folder management functions
				window.showEditFolderModal = function(folderId, folderName, folderDescription) {
					// Load the edit modal with the folder data
					fetch(`/folders/${folderId}/edit`)
						.then(response => {
							if (!response.ok) {
								throw new Error(`HTTP error! status: ${response.status}`);
							}
							return response.text();
						})
						.then(html => {
							document.getElementById('editFolderModalContainer').innerHTML = html;
							// The modal should now be in the DOM, try to show it
							const modal = document.getElementById('editFolderModal');
							if (modal) {
								modal.classList.remove('hidden');
							} else {
								console.error('Edit modal not found in returned HTML');
							}
						})
						.catch(error => {
							console.error('Error loading edit modal:', error);
							alert('Failed to load edit form. Please try again.');
						});
				}

				window.showDeleteFolderModal = function(folderId, folderName) {
					document.getElementById('folderNameToDelete').textContent = folderName;
					document.getElementById('deleteFolderModal').classList.remove('hidden');

					// Set up the delete confirmation
					document.getElementById('confirmDeleteFolder').onclick = function() {
						// Make HTMX delete request
						fetch(`/api/folders/${folderId}`, {
							method: 'DELETE',
							headers: {
								'HX-Request': 'true'
							}
						})
						.then(response => {
							if (response.ok) {
								// Reload the page to show updated folder list
								window.location.reload();
							} else {
								console.error('Failed to delete folder');
								alert('Failed to delete folder. Please try again.');
							}
						})
						.catch(error => {
							console.error('Error deleting folder:', error);
							alert('Error deleting folder. Please try again.');
						})
						.finally(() => {
							closeModal('deleteFolderModal');
						});
					}
				}

				// Listen for HTMX events to close modals after successful operations
				document.addEventListener('htmx:afterRequest', function(e) {
					// Check if this was a successful request
					if (e.detail.successful) {
						const url = e.detail.xhr.responseURL;
						console.log('HTMX request successful:', url);

						// Close modals after successful folder operations
						if (url.includes('/api/folders')) {
							console.log('Folder operation successful, closing modals');
							closeModal('createFolderModal');
							closeModal('editFolderModal');
							closeModal('deleteFolderModal');

							// Clear the forms
							const createForm = document.querySelector('#createFolderModal form');
							if (createForm) createForm.reset();

							// Clear the edit modal container
							const editContainer = document.getElementById('editFolderModalContainer');
							if (editContainer) editContainer.innerHTML = '';

							// If we're on the folders page and this was a folder update/delete, reload
							if (window.location.pathname === '/folders' && (e.detail.xhr.method === 'PUT' || e.detail.xhr.method === 'DELETE')) {
								window.location.reload();
							}
						}
					}
				});
			});
		</script>
	}
}
