package templates

import "mh-go/internal/models"

// Create Folder Modal
templ CreateFolderModal() {
	@Modal("createFolderModal", "Create New Folder") {
		<form hx-post="/api/folders" hx-target="#folders-container" hx-swap="afterbegin">
			<div class="mb-4">
				<label for="name" class="block text-sm font-medium text-gray-700">Folder Name</label>
				<input
					type="text"
					id="name"
					name="name"
					required
					class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-[var(--color-primary)] focus:border-[var(--color-primary)]"
					placeholder="Enter folder name"
				/>
			</div>
			<div class="mb-4">
				<label for="description" class="block text-sm font-medium text-gray-700">Description</label>
				<textarea
					id="description"
					name="description"
					rows="3"
					class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-[var(--color-primary)] focus:border-[var(--color-primary)]"
					placeholder="Enter folder description (optional)"
				></textarea>
			</div>
			<div class="flex justify-end space-x-3">
				<button
					type="button"
					onclick="closeModal('createFolderModal')"
					class="px-4 py-2 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50"
				>
					Cancel
				</button>
				<button
					type="submit"
					class="px-4 py-2 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-[var(--color-primary)] hover:bg-[var(--color-primary-hover)]"
				>
					Create Folder
				</button>
			</div>
		</form>
	}
}

// Create Content Modal
templ CreateContentModal(folderID string) {
	@Modal("createContentModal", "Create New Content") {
		<form hx-post={ "/api/folders/" + folderID + "/content" } hx-target="#content-container" hx-swap="afterbegin">
			<input type="hidden" name="folder_id" value={ folderID }/>

			<!-- Title toggle switch -->
			<div class="mb-4 flex items-center justify-between">
				<label class="text-sm font-medium text-gray-700">Auto generate title as a question</label>
				<label class="relative inline-flex items-center cursor-pointer">
					<input type="checkbox" id="autoTitleToggle" class="sr-only peer" checked>
					<div class="w-11 h-6 bg-gray-200 peer-focus:outline-none peer-focus:ring-4 peer-focus:ring-[rgba(var(--color-teal-500-rgb),0.3)] rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-[var(--color-primary)]"></div>
				</label>
			</div>

			<!-- Title field (hidden by default) -->
			<div class="mb-4 hidden" id="titleField">
				<label for="title" class="block text-sm font-medium text-gray-700">Title</label>
				<input
					type="text"
					id="title"
					name="title"
					class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-[var(--color-primary)] focus:border-[var(--color-primary)]"
					placeholder="Enter content title (will be used instead of auto-generated question)"
				/>
				<p class="mt-1 text-xs text-gray-500">Leave empty to auto-generate a question from your content</p>
			</div>

			<div class="mb-4">
				<label for="body" class="block text-sm font-medium text-gray-700">Content</label>
				<textarea
					id="body"
					name="body"
					rows="6"
					required
					class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-[var(--color-primary)] focus:border-[var(--color-primary)]"
					placeholder="Enter your content here... (A question will be automatically generated from this)"
				></textarea>
				<p class="mt-1 text-xs text-gray-500">This will be the content. A question will be automatically generated to help you learn.</p>
			</div>

			<div class="flex justify-end space-x-3">
				<button
					type="button"
					onclick="closeModal('createContentModal')"
					class="px-4 py-2 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50"
				>
					Cancel
				</button>
				<button
					type="submit"
					class="px-4 py-2 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-[var(--color-primary)] hover:bg-[var(--color-primary-hover)] transition-colors"
				>
					Create Content
				</button>
			</div>
		</form>

		<script>
			// Handle title toggle switch
			document.addEventListener('DOMContentLoaded', function() {
				const autoTitleToggle = document.getElementById('autoTitleToggle');
				const titleField = document.getElementById('titleField');
				const titleInput = document.getElementById('title');

				autoTitleToggle.addEventListener('change', function() {
					if (this.checked) {
						// Auto-generate mode: hide title field
						titleField.classList.add('hidden');
						titleInput.required = false;
						titleInput.value = ''; // Clear the title when hiding
					} else {
						// Manual title mode: show title field
						titleField.classList.remove('hidden');
						titleInput.required = false; // Title is still optional
					}
				});
			});
		</script>
	}
}

// View Content Modal
templ ViewContentModal(content models.Content) {
	@Modal("viewContentModal", content.Title) {
		<div class="space-y-4">
			if content.Description != "" {
				<div class="border-b border-gray-200 pb-3">
					<p class="text-sm text-gray-600">{ content.Description }</p>
				</div>
			}

			<div class="content-display">
				if content.ContentType == "markdown" {
					<div class="prose prose-sm max-w-none">
						<!-- Markdown content will be rendered here -->
						<div id="markdown-content" class="whitespace-pre-wrap">{ content.Body }</div>
					</div>
				} else if content.ContentType == "link" {
					<div class="flex items-center space-x-3 p-4 bg-[var(--color-feature-blue)] rounded-lg">
						<svg class="w-5 h-5 text-[var(--color-feature-blue-text)]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v7a2 2 0 002 2h4m-4-9a2 2 0 012-2h4m5 18v-3a2 2 0 00-2-2H9a2 2 0 00-2 2v3m8 0V9a2 2 0 00-2-2H9a2 2 0 00-2 2v8m8 0h4"></path>
						</svg>
						<a href={ templ.URL(content.Body) } target="_blank" rel="noopener noreferrer" class="text-[var(--color-feature-blue-text)] hover:text-blue-800 underline break-all">
							{ content.Body }
						</a>
					</div>
				} else {
					<div class="bg-gray-50 p-4 rounded-lg">
						<pre class="whitespace-pre-wrap text-sm text-gray-700 font-mono">{ content.Body }</pre>
					</div>
				}
			</div>

			<div class="flex items-center justify-between text-sm text-gray-500 pt-3 border-t border-gray-200">
				<span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-800">
					{ content.ContentType }
				</span>
				<span>Created: { content.CreatedAt.Format("Jan 2, 2006 at 3:04 PM") }</span>
			</div>

			<div class="flex justify-end space-x-3 pt-4">
				<button
					type="button"
					onclick="closeModal('viewContentModal')"
					class="px-4 py-2 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50"
				>
					Close
				</button>
				<button
					type="button"
					onclick="closeModal('viewContentModal'); showEditContentModal('{ content.ID.String() }')"
					class="px-4 py-2 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-[var(--color-primary)] hover:bg-[var(--color-primary-hover)] transition-colors"
				>
					Edit Content
				</button>
			</div>
		</div>
	}
}

// Edit Folder Modal
templ EditFolderModal(folder models.Folder) {
	@Modal("editFolderModal", "Edit Folder") {
		<form hx-put={ "/api/folders/" + folder.ID.String() } hx-target="body" hx-swap="outerHTML">
			<div class="mb-4">
				<label for="edit_name" class="block text-sm font-medium text-gray-700">Folder Name</label>
				<input
					type="text"
					id="edit_name"
					name="name"
					value={ folder.Name }
					required
					class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-[var(--color-primary)] focus:border-[var(--color-primary)]"
				/>
			</div>
			<div class="mb-4">
				<label for="edit_description" class="block text-sm font-medium text-gray-700">Description</label>
				<textarea
					id="edit_description"
					name="description"
					rows="3"
					class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-[var(--color-primary)] focus:border-[var(--color-primary)]"
				>{ folder.Description }</textarea>
			</div>
			<div class="flex justify-end space-x-3">
				<button
					type="button"
					onclick="closeModal('editFolderModal')"
					class="px-4 py-2 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50"
				>
					Cancel
				</button>
				<button
					type="submit"
					class="px-4 py-2 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-[var(--color-primary)] hover:bg-[var(--color-primary-hover)] transition-colors"
				>
					Update Folder
				</button>
			</div>
		</form>
	}
}

// Edit Content Modal
templ EditContentModal(content models.Content) {
	@Modal("editContentModal", "Edit Content") {
		<form hx-put={ "/api/content/" + content.ID.String() } hx-target="body" hx-swap="outerHTML">
			<div class="mb-4">
				<label for="edit_content_title" class="block text-sm font-medium text-gray-700">Title</label>
				<input
					type="text"
					id="edit_content_title"
					name="title"
					value={ content.Title }
					required
					class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-[var(--color-primary)] focus:border-[var(--color-primary)]"
				/>
			</div>

			<div class="mb-4">
				<label for="edit_content_description" class="block text-sm font-medium text-gray-700">Description</label>
				<input
					type="text"
					id="edit_content_description"
					name="description"
					value={ content.Description }
					class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-[var(--color-primary)] focus:border-[var(--color-primary)]"
				/>
			</div>

			<div class="mb-4">
				<label for="edit_content_body" class="block text-sm font-medium text-gray-700">Content</label>
				<textarea
					id="edit_content_body"
					name="body"
					rows="6"
					required
					class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-[var(--color-primary)] focus:border-[var(--color-primary)]"
					placeholder="Enter your content here... (Markdown is automatically detected)"
				>{ content.Body }</textarea>
			</div>

			<div class="flex justify-end space-x-3">
				<button
					type="button"
					onclick="closeModal('editContentModal')"
					class="px-4 py-2 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50"
				>
					Cancel
				</button>
				<button
					type="submit"
					class="px-4 py-2 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-[var(--color-primary)] hover:bg-[var(--color-primary-hover)] transition-colors"
				>
					Update Content
				</button>
			</div>
		</form>
	}
}

// Delete Confirmation Modal
templ DeleteConfirmationModal(itemType, itemID, itemName string) {
	@Modal("deleteModal", "Delete " + itemType) {
		<div class="mb-4">
			<div class="flex items-center">
				<div class="flex-shrink-0">
					<svg class="h-6 w-6 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.732-.833-2.5 0L3.732 16.5c-.77.833.192 2.5 1.732 2.5z"></path>
					</svg>
				</div>
				<div class="ml-3">
					<h3 class="text-lg font-medium text-gray-900">Delete { itemType }</h3>
					<div class="mt-2">
						<p class="text-sm text-gray-500">
							Are you sure you want to delete "{ itemName }"? This action cannot be undone.
						</p>
					</div>
				</div>
			</div>
		</div>

		<div class="flex justify-end space-x-3">
			<button
				type="button"
				onclick="closeModal('deleteModal')"
				class="px-4 py-2 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50"
			>
				Cancel
			</button>
			<button
				hx-delete={ "/api/" + itemType + "s/" + itemID }
				hx-target="body"
				hx-swap="outerHTML"
				class="px-4 py-2 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-red-600 hover:bg-red-700 transition-colors"
			>
				Delete { itemType }
			</button>
		</div>
	}
}

// Delete Folder Modal
templ DeleteFolderModal() {
	@Modal("deleteFolderModal", "Delete Folder") {
		<div class="mb-4">
			<div class="flex items-center mb-4">
				<div class="mx-auto flex-shrink-0 flex items-center justify-center h-12 w-12 rounded-full bg-red-100">
					<svg class="h-6 w-6 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L3.732 16.5c-.77.833.192 2.5 1.732 2.5z"></path>
					</svg>
				</div>
			</div>
			<div class="text-center">
				<h3 class="text-lg font-medium text-gray-900 mb-2">Delete Folder</h3>
				<p class="text-sm text-gray-500 mb-4">Are you sure you want to delete this folder? This action cannot be undone and will delete all contents within the folder.</p>
				<p class="text-sm font-medium text-gray-900" id="folderNameToDelete"></p>
			</div>
		</div>
		<div class="flex justify-end space-x-3">
			<button
				type="button"
				onclick="closeModal('deleteFolderModal')"
				class="px-4 py-2 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50"
			>
				Cancel
			</button>
			<button
				type="button"
				id="confirmDeleteFolder"
				class="px-4 py-2 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-red-600 hover:bg-red-700 transition-colors"
			>
				Delete Folder
			</button>
		</div>
	}
}
