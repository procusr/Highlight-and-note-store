package templates

import "mh-go/internal/models"

// Create Content Modal
templ CreateContentModal(folderID string) {
	@Modal("createContentModal", "Create New Content") {
		<form hx-post={ "/api/folders/" + folderID + "/content" } hx-target="#content-container" hx-swap="afterbegin">
			<input type="hidden" name="folder_id" value={ folderID }/>

			<div class="mb-4">
				<label for="title" class="block text-sm font-medium text-gray-700">Title</label>
				<input
					type="text"
					id="title"
					name="title"
					required
					class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-indigo-500 focus:border-indigo-500"
					placeholder="Enter content title"
				/>
			</div>

			<div class="mb-4">
				<label for="description" class="block text-sm font-medium text-gray-700">Description</label>
				<input
					type="text"
					id="description"
					name="description"
					class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-indigo-500 focus:border-indigo-500"
					placeholder="Enter content description (optional)"
				/>
			</div>

			<div class="mb-4">
				<label for="content_type" class="block text-sm font-medium text-gray-700">Content Type</label>
				<select
					id="content_type"
					name="content_type"
					class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-indigo-500 focus:border-indigo-500"
				>
					<option value="text">Text</option>
					<option value="markdown">Markdown</option>
					<option value="file">File</option>
					<option value="link">Link</option>
				</select>
			</div>

			<div class="mb-4">
				<label for="body" class="block text-sm font-medium text-gray-700">Content</label>
				<textarea
					id="body"
					name="body"
					rows="6"
					required
					class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-indigo-500 focus:border-indigo-500"
					placeholder="Enter your content here..."
				></textarea>
			</div>

			<div class="flex justify-end space-x-3">
				<button
					type="button"
					onclick="closeModal('createContentModal')"
					class="px-4 py-2 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50"
				>
					Cancel
				</button>
				<button
					type="submit"
					class="px-4 py-2 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-gray-800 hover:bg-gray-900 transition-colors"
				>
					Create Content
				</button>
			</div>
		</form>
	}
}

// Edit Folder Modal
templ EditFolderModal(folder models.Folder) {
	@Modal("editFolderModal", "Edit Folder") {
		<form hx-put={ "/api/folders/" + folder.ID.String() } hx-target="body" hx-swap="outerHTML">
			<div class="mb-4">
				<label for="edit_name" class="block text-sm font-medium text-gray-700">Folder Name</label>
				<input
					type="text"
					id="edit_name"
					name="name"
					value={ folder.Name }
					required
					class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-indigo-500 focus:border-indigo-500"
				/>
			</div>
			<div class="mb-4">
				<label for="edit_description" class="block text-sm font-medium text-gray-700">Description</label>
				<textarea
					id="edit_description"
					name="description"
					rows="3"
					class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-indigo-500 focus:border-indigo-500"
				>{ folder.Description }</textarea>
			</div>
			<div class="flex justify-end space-x-3">
				<button
					type="button"
					onclick="closeModal('editFolderModal')"
					class="px-4 py-2 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50"
				>
					Cancel
				</button>
				<button
					type="submit"
					class="px-4 py-2 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-gray-800 hover:bg-gray-900 transition-colors"
				>
					Update Folder
				</button>
			</div>
		</form>
	}
}

// Edit Content Modal
templ EditContentModal(content models.Content) {
	@Modal("editContentModal", "Edit Content") {
		<form hx-put={ "/api/content/" + content.ID.String() } hx-target="body" hx-swap="outerHTML">
			<div class="mb-4">
				<label for="edit_content_title" class="block text-sm font-medium text-gray-700">Title</label>
				<input
					type="text"
					id="edit_content_title"
					name="title"
					value={ content.Title }
					required
					class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-indigo-500 focus:border-indigo-500"
				/>
			</div>

			<div class="mb-4">
				<label for="edit_content_description" class="block text-sm font-medium text-gray-700">Description</label>
				<input
					type="text"
					id="edit_content_description"
					name="description"
					value={ content.Description }
					class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-indigo-500 focus:border-indigo-500"
				/>
			</div>

			<div class="mb-4">
				<label for="edit_content_type" class="block text-sm font-medium text-gray-700">Content Type</label>
				<select
					id="edit_content_type"
					name="content_type"
					class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-indigo-500 focus:border-indigo-500"
				>
					<option value="text" selected?={ content.ContentType == "text" }>Text</option>
					<option value="markdown" selected?={ content.ContentType == "markdown" }>Markdown</option>
					<option value="file" selected?={ content.ContentType == "file" }>File</option>
					<option value="link" selected?={ content.ContentType == "link" }>Link</option>
				</select>
			</div>

			<div class="mb-4">
				<label for="edit_content_body" class="block text-sm font-medium text-gray-700">Content</label>
				<textarea
					id="edit_content_body"
					name="body"
					rows="6"
					required
					class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-indigo-500 focus:border-indigo-500"
				>{ content.Body }</textarea>
			</div>

			<div class="flex justify-end space-x-3">
				<button
					type="button"
					onclick="closeModal('editContentModal')"
					class="px-4 py-2 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50"
				>
					Cancel
				</button>
				<button
					type="submit"
					class="px-4 py-2 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-gray-800 hover:bg-gray-900 transition-colors"
				>
					Update Content
				</button>
			</div>
		</form>
	}
}

// Delete Confirmation Modal
templ DeleteConfirmationModal(itemType, itemID, itemName string) {
	@Modal("deleteModal", "Delete " + itemType) {
		<div class="mb-4">
			<div class="flex items-center">
				<div class="flex-shrink-0">
					<svg class="h-6 w-6 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.732-.833-2.5 0L3.732 16.5c-.77.833.192 2.5 1.732 2.5z"></path>
					</svg>
				</div>
				<div class="ml-3">
					<h3 class="text-lg font-medium text-gray-900">Delete { itemType }</h3>
					<div class="mt-2">
						<p class="text-sm text-gray-500">
							Are you sure you want to delete "{ itemName }"? This action cannot be undone.
						</p>
					</div>
				</div>
			</div>
		</div>

		<div class="flex justify-end space-x-3">
			<button
				type="button"
				onclick="closeModal('deleteModal')"
				class="px-4 py-2 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50"
			>
				Cancel
			</button>
			<button
				hx-delete={ "/api/" + itemType + "s/" + itemID }
				hx-target="body"
				hx-swap="outerHTML"
				class="px-4 py-2 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-red-600 hover:bg-red-700 transition-colors"
			>
				Delete { itemType }
			</button>
		</div>
	}
}
