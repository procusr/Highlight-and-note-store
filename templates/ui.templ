package templates

// Alert component
templ Alert(message, alertType string) {
	<div class={ "alert", "p-4", "rounded-md", "mb-4", getAlertClasses(alertType) }>
		{ message }
	</div>
}

// Loading spinner component
templ LoadingSpinner() {
	<div class="flex justify-center items-center p-4">
		<div class="animate-spin rounded-full h-8 w-8 border-b-2 border-indigo-600"></div>
	</div>
}

// Simple Modal component (without complex scripts)
templ Modal(id, title string) {
	<div id={ id } class="fixed inset-0 bg-gray-600/60 backdrop-blur-sm flex items-start sm:items-center justify-center overflow-y-auto h-full w-full hidden z-50 p-2 sm:p-4">
		<div class="relative w-full max-w-md sm:max-w-lg md:max-w-xl bg-white shadow-xl rounded-lg border border-gray-200 animate-fade-in">
			<div class="flex flex-row justify-between items-start gap-4 p-4 pb-2 border-b border-gray-100">
				<h3 class="text-base sm:text-lg font-semibold text-gray-900 leading-tight flex-1">{ title }</h3>
				<button data-modal-close={ id } class="text-gray-400 hover:text-gray-600 p-1 rounded transition-colors">
					<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
					</svg>
				</button>
			</div>
			<div class="modal-body p-4 pt-3 space-y-4">
				{ children... }
			</div>
		</div>
	</div>
}

// Additional modal animations (can be moved to CSS file later)
templ ModalStyles() {
	<style>
	@keyframes fade-in { from { opacity:0; transform: translateY(4px);} to { opacity:1; transform: translateY(0);} }
	.animate-fade-in { animation: fade-in 0.18s ease-out; }
	</style>
}

// Helper function for alert classes
func getAlertClasses(alertType string) string {
	switch alertType {
	case "success":
		return "bg-green-100 border border-green-400 text-green-700"
	case "error":
		return "bg-red-100 border border-red-400 text-red-700"
	case "warning":
		return "bg-yellow-100 border border-yellow-400 text-yellow-700"
	default:
		return "bg-blue-100 border border-blue-400 text-blue-700"
	}
}

// Helper function for sidebar link classes
func getSidebarLinkClass(page, currentPage string) string {
	baseClasses := "flex items-center px-3 py-2 text-sm font-medium rounded-md transition-colors"
	if page == currentPage {
		return baseClasses + " bg-gray-100 text-gray-900"
	}
	return baseClasses + " text-gray-600 hover:text-gray-900 hover:bg-gray-50"
}
