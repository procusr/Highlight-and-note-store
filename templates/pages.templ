package templates

import "mh-go/internal/models"

// Login page
templ LoginPage() {
	@Layout("Login") {
		<div class="min-h-screen flex items-center justify-center">
			<div class="max-w-md w-full space-y-8">
				<div>
					<h2 class="mt-6 text-center text-3xl font-extrabold text-gray-900">
						Sign in to your account
					</h2>
				</div>
				<form class="mt-8 space-y-6" hx-post="/login" hx-target="#error" hx-swap="innerHTML">
					<div class="rounded-md shadow-sm -space-y-px">
						<div>
							<input
								name="email"
								type="email"
								required
								class="relative block w-full px-3 py-2 border border-gray-300 placeholder-gray-500 text-gray-900 rounded-t-md focus:outline-none focus:ring-indigo-500 focus:border-indigo-500"
								placeholder="Email address"
							/>
						</div>
						<div>
							<input
								name="password"
								type="password"
								required
								class="relative block w-full px-3 py-2 border border-gray-300 placeholder-gray-500 text-gray-900 rounded-b-md focus:outline-none focus:ring-indigo-500 focus:border-indigo-500"
								placeholder="Password"
							/>
						</div>
					</div>
					<div id="error" class="text-red-600 text-sm"></div>
					<div>
						<button
							type="submit"
							class="group relative w-full flex justify-center py-2 px-4 border border-transparent text-sm font-medium rounded-md text-white bg-gray-800 hover:bg-gray-900 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-gray-500 transition-colors"
						>
							Sign in
						</button>
					</div>
					<div class="text-center">
						<a href="/register" class="text-gray-600 hover:text-gray-800 font-medium">
							Don't have an account? Sign up
						</a>
					</div>
				</form>
			</div>
		</div>
	}
}

// Register page
templ RegisterPage() {
	@Layout("Register") {
		<div class="min-h-screen flex items-center justify-center">
			<div class="max-w-md w-full space-y-8">
				<div>
					<h2 class="mt-6 text-center text-3xl font-extrabold text-gray-900">
						Create your account
					</h2>
				</div>
				<form class="mt-8 space-y-6" hx-post="/register" hx-target="#error" hx-swap="innerHTML">
					<div class="rounded-md shadow-sm -space-y-px">
						<div>
							<input
								name="email"
								type="email"
								required
								class="relative block w-full px-3 py-2 border border-gray-300 placeholder-gray-500 text-gray-900 rounded-t-md focus:outline-none focus:ring-indigo-500 focus:border-indigo-500"
								placeholder="Email address"
							/>
						</div>
						<div>
							<input
								name="password"
								type="password"
								required
								class="relative block w-full px-3 py-2 border border-gray-300 placeholder-gray-500 text-gray-900 focus:outline-none focus:ring-indigo-500 focus:border-indigo-500"
								placeholder="Password"
							/>
						</div>
						<div>
							<input
								name="confirm_password"
								type="password"
								required
								class="relative block w-full px-3 py-2 border border-gray-300 placeholder-gray-500 text-gray-900 rounded-b-md focus:outline-none focus:ring-indigo-500 focus:border-indigo-500"
								placeholder="Confirm Password"
							/>
						</div>
					</div>
					<div id="error" class="text-red-600 text-sm"></div>
					<div>
						<button
							type="submit"
							class="group relative w-full flex justify-center py-2 px-4 border border-transparent text-sm font-medium rounded-md text-white bg-gray-800 hover:bg-gray-900 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-gray-500 transition-colors"
						>
							Sign up
						</button>
					</div>
					<div class="text-center">
						<a href="/login" class="text-gray-600 hover:text-gray-800 font-medium">
							Already have an account? Sign in
						</a>
					</div>
				</form>
			</div>
		</div>
	}
}

// Folder view page
templ FolderPage(user *models.User, folder models.Folder, contents []models.Content, subfolders []models.Folder) {
	@Layout("Folder: " + folder.Name) {
		@Navigation(user)
		@Sidebar("folder")
		<div class="main-content md:ml-64 pt-16">
			<div class="max-w-7xl mx-auto py-6 px-4">
			<!-- Breadcrumb -->
			<nav class="flex mb-6" aria-label="Breadcrumb">
				<ol class="inline-flex items-center space-x-1 md:space-x-3">
					<li class="inline-flex items-center">
						<a href="/dashboard" class="text-gray-700 hover:text-gray-900">
							Dashboard
						</a>
					</li>
					<li>
						<div class="flex items-center">
							<svg class="w-6 h-6 text-gray-400" fill="currentColor" viewBox="0 0 20 20">
								<path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"></path>
							</svg>
							<span class="text-gray-500 ml-1 md:ml-2">{ folder.Name }</span>
						</div>
					</li>
				</ol>
			</nav>

			<!-- Folder Header -->
			<div class="flex justify-between items-center mb-6">
				<div>
					<h1 class="text-2xl font-bold text-gray-900">{ folder.Name }</h1>
					if folder.Description != "" {
						<p class="text-gray-600 mt-2">{ folder.Description }</p>
					}
				</div>
				<div class="flex space-x-3">
					<button
						onclick="showCreateContentModal()"
						class="bg-gray-800 hover:bg-gray-900 text-white px-4 py-2 rounded-md text-sm font-medium transition-colors"
					>
						New Content
					</button>
				</div>
			</div>

			<!-- Subfolders -->
			if len(subfolders) > 0 {
				<div class="mb-8">
					<h2 class="text-lg font-semibold text-gray-900 mb-4">Folders</h2>
					<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
						for _, subfolder := range subfolders {
							@FolderCard(subfolder)
						}
					</div>
				</div>
			}

			<!-- Content -->
			if len(contents) > 0 {
				<div>
					<h2 class="text-lg font-semibold text-gray-900 mb-4">Content</h2>
					<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
						for _, content := range contents {
							@ContentCard(content)
						}
					</div>
				</div>
			}

			if len(subfolders) == 0 && len(contents) == 0 {
				<div class="text-center py-12">
					<svg class="mx-auto h-12 w-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 2a1 1 0 000 2h6a1 1 0 100-2H9z"></path>
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"></path>
					</svg>
					<h3 class="mt-2 text-sm font-medium text-gray-900">No items</h3>
					<p class="mt-1 text-sm text-gray-500">Get started by creating a new folder or content.</p>
				</div>
			}
			</div>
		</div>
	}
}

// Folders page
templ FoldersPage(user *models.User, folders []models.Folder) {
	@Layout("Folders") {
		@Navigation(user)
		@Sidebar("folders")

		<main class="main-content md:ml-64 min-h-screen bg-gray-50 pt-16">
			<div class="max-w-6xl mx-auto py-6 md:py-8 px-4 md:px-6">
				<div class="mb-6 md:mb-8">
					<div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
						<div>
							<h1 class="text-xl md:text-2xl font-semibold text-gray-900 mb-2">All Folders</h1>
							<p class="text-gray-600 text-sm md:text-base">Organize your content into folders for easy management.</p>
						</div>
						<button
							onclick="showCreateFolderModal()"
							class="inline-flex items-center px-3 md:px-4 py-2 text-xs md:text-sm font-medium text-white bg-gray-900 border border-transparent rounded-md hover:bg-gray-800 transition-colors"
						>
							<svg class="w-3 h-3 md:w-4 md:h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
							</svg>
							New Folder
						</button>
					</div>
				</div>

				if len(folders) > 0 {
					<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-3 md:gap-4" id="folders-container">
						for _, folder := range folders {
							@FolderCard(folder)
						}
					</div>
				} else {
					<div class="text-center py-12 md:py-16">
						<div class="mx-auto w-12 h-12 md:w-16 md:h-16 bg-gray-100 rounded-full flex items-center justify-center mb-4">
							<svg class="h-6 w-6 md:h-8 md:w-8 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2H5a2 2 0 00-2-2z"></path>
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 5a2 2 0 012-2h4a2 2 0 012 2v2H8V5z"></path>
							</svg>
						</div>
						<h3 class="text-base md:text-lg font-medium text-gray-900 mb-2">No folders yet</h3>
						<p class="text-gray-600 text-sm md:text-base px-4 mb-6">Get started by creating your first folder to organize your content.</p>
						<button
							onclick="showCreateFolderModal()"
							class="inline-flex items-center px-4 py-2 text-sm font-medium text-white bg-gray-900 border border-transparent rounded-md hover:bg-gray-800 transition-colors"
						>
							<svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
							</svg>
							Create Your First Folder
						</button>
					</div>
				}
			</div>
		</main>

		<!-- Create Folder Modal -->
		@CreateFolderModal()

		<!-- JavaScript for modal functionality -->
		<script>
			// Simple modal management
			document.addEventListener('DOMContentLoaded', function() {
				// Show create folder modal
				window.showCreateFolderModal = function() {
					document.getElementById('createFolderModal').classList.remove('hidden');
				}

				// Close modal by ID
				window.closeModal = function(modalId) {
					document.getElementById(modalId).classList.add('hidden');
				}

				// Handle modal close buttons
				document.addEventListener('click', function(e) {
					if (e.target.hasAttribute('data-modal-close')) {
						const modalId = e.target.getAttribute('data-modal-close');
						closeModal(modalId);
					}
				});

				// Close modal when clicking outside
				window.onclick = function(event) {
					const modal = document.getElementById('createFolderModal');
					if (event.target === modal) {
						modal.classList.add('hidden');
					}
				}

				// Folder management functions
				window.editFolder = function(folderId) {
					console.log('Edit folder:', folderId);
					// TODO: Implement edit functionality
				}

				window.deleteFolder = function(folderId) {
					if (confirm('Are you sure you want to delete this folder?')) {
						console.log('Delete folder:', folderId);
						// TODO: Implement delete functionality
					}
				}
			});
		</script>
	}
}// Flashcards page
templ FlashcardsPage(user *models.User) {
	@Layout("Flashcards") {
		@Navigation(user)
		@Sidebar("flashcards")

		<main class="main-content md:ml-64 min-h-screen bg-gray-50 pt-16">
			<div class="max-w-6xl mx-auto py-6 md:py-8 px-4 md:px-6">
				<div class="mb-6 md:mb-8">
					<h1 class="text-xl md:text-2xl font-semibold text-gray-900 mb-2">Flashcards</h1>
					<p class="text-gray-600 text-sm md:text-base">Study and memorize content with interactive flashcards.</p>
				</div>

				<div class="text-center py-12 md:py-16">
					<div class="mx-auto w-12 h-12 md:w-16 md:h-16 bg-gray-100 rounded-full flex items-center justify-center mb-4">
						<svg class="h-6 w-6 md:h-8 md:w-8 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path>
						</svg>
					</div>
					<h3 class="text-base md:text-lg font-medium text-gray-900 mb-2">Flashcards</h3>
					<p class="text-gray-600 text-sm md:text-base px-4">Create and study flashcards to enhance your learning experience.</p>
				</div>
			</div>
		</main>
	}
}

// Settings page
templ SettingsPage(user *models.User) {
	@Layout("Settings") {
		@Navigation(user)
		@Sidebar("settings")

		<main class="main-content md:ml-64 min-h-screen bg-gray-50 pt-16">
			<div class="max-w-6xl mx-auto py-6 md:py-8 px-4 md:px-6">
				<div class="mb-6 md:mb-8">
					<h1 class="text-xl md:text-2xl font-semibold text-gray-900 mb-2">Settings</h1>
					<p class="text-gray-600 text-sm md:text-base">Manage your account preferences and application settings.</p>
				</div>

				<div class="bg-white rounded-lg border border-gray-200 p-4 md:p-6">
					<h3 class="text-base md:text-lg font-medium text-gray-900 mb-4">Account Information</h3>
					<div class="space-y-4">
						<div>
							<label class="block text-xs md:text-sm font-medium text-gray-700">Email</label>
							<p class="mt-1 text-sm md:text-base text-gray-900">{ user.Email }</p>
						</div>
						<div>
							<label class="block text-xs md:text-sm font-medium text-gray-700">Account created</label>
							<p class="mt-1 text-sm md:text-base text-gray-900">{ user.CreatedAt.Format("January 2, 2006") }</p>
						</div>
					</div>
				</div>
			</div>
		</main>
	}
}
