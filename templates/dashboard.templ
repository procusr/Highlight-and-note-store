package templates

import (
	"fmt"
	"mh-go/internal/models"
)

// Dashboard page
templ DashboardPage(user *models.User, folders []models.Folder) {
	@Layout("Dashboard") {
		@Navigation(user)
		@Sidebar("dashboard")

		<!-- Main content with sidebar offset -->
		<main class="main-content md:ml-28 min-h-screen bg-gray-50 pt-16">
			<div class="max-w-6xl mx-auto py-6 md:py-8 px-4 md:px-6">
				<!-- Dashboard Header -->
				<div class="mb-6 md:mb-8">
					<h1 class="text-xl md:text-2xl font-semibold text-gray-900 mb-2">Dashboard</h1>
					<p class="text-gray-600 text-sm md:text-base">Welcome back, { user.Email }</p>
				</div>

				<!-- Statistics Cards -->
				<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 md:gap-6 mb-6 md:mb-8">
					<div class="bg-white rounded-lg border border-gray-200 p-4 md:p-6">
						<div class="flex items-center">
							<div class="p-2 bg-gray-100 rounded-lg">
								<svg class="h-5 w-5 md:h-6 md:w-6 text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2H5a2 2 0 00-2-2z"></path>
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 5a2 2 0 012-2h4a2 2 0 012 2v2H8V5z"></path>
								</svg>
							</div>
							<div class="ml-3 md:ml-4">
								<p class="text-xs md:text-sm font-medium text-gray-600">Total Folders</p>
								<p class="text-lg md:text-2xl font-semibold text-gray-900">{ templ.EscapeString(fmt.Sprintf("%d", len(folders))) }</p>
							</div>
						</div>
					</div>

					<div class="bg-white rounded-lg border border-gray-200 p-4 md:p-6">
						<div class="flex items-center">
							<div class="p-2 bg-gray-100 rounded-lg">
								<svg class="h-5 w-5 md:h-6 md:w-6 text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
								</svg>
							</div>
							<div class="ml-3 md:ml-4">
								<p class="text-xs md:text-sm font-medium text-gray-600">Total Content</p>
								<p class="text-lg md:text-2xl font-semibold text-gray-900">0</p>
							</div>
						</div>
					</div>

					<div class="bg-white rounded-lg border border-gray-200 p-4 md:p-6 sm:col-span-2 lg:col-span-1">
						<div class="flex items-center">
							<div class="p-2 bg-gray-100 rounded-lg">
								<svg class="h-5 w-5 md:h-6 md:w-6 text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
								</svg>
							</div>
							<div class="ml-3 md:ml-4">
								<p class="text-xs md:text-sm font-medium text-gray-600">Last Activity</p>
								<p class="text-lg md:text-2xl font-semibold text-gray-900">Today</p>
							</div>
						</div>
					</div>
				</div>

				<!-- Recent Folders Section -->
				if len(folders) > 0 {
					<div>
						<div class="flex flex-col sm:flex-row sm:items-center justify-between mb-4 md:mb-6 gap-4">
							<h2 class="text-base md:text-lg font-medium text-gray-900">Recent Folders</h2>
							<button
								onclick="showCreateFolderModal()"
								class="inline-flex items-center px-3 md:px-4 py-2 text-xs md:text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-md hover:bg-gray-50 transition-colors"
							>
								<svg class="w-3 h-3 md:w-4 md:h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
								</svg>
								New Folder
							</button>
						</div>
						<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3 md:gap-4" id="folders-container">
							for _, folder := range folders {
								@FolderCard(folder)
							}
						</div>
					</div>
				} else {
					<div class="text-center py-12 md:py-16">
						<div class="mx-auto w-12 h-12 md:w-16 md:h-16 bg-gray-100 rounded-full flex items-center justify-center mb-4">
							<svg class="h-6 w-6 md:h-8 md:w-8 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2H5a2 2 0 00-2-2z"></path>
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 5a2 2 0 012-2h4a2 2 0 012 2v2H8V5z"></path>
							</svg>
						</div>
						<h3 class="text-base md:text-lg font-medium text-gray-900 mb-2">No folders yet</h3>
						<p class="text-gray-600 mb-6 text-sm md:text-base px-4">Get started by creating your first folder to organize your content.</p>
						<button
							onclick="showCreateFolderModal()"
							class="inline-flex items-center px-4 py-2 text-sm font-medium text-white bg-gray-900 border border-transparent rounded-md hover:bg-gray-800 transition-colors"
						>
							<svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
							</svg>
							Create Your First Folder
						</button>
					</div>
				}
			</div>
		</main>

		<!-- Create Folder Modal -->
		@CreateFolderModal()

		<!-- JavaScript for modal functionality -->
		<script>
			// Simple modal management
			document.addEventListener('DOMContentLoaded', function() {
				// Show create folder modal
				window.showCreateFolderModal = function() {
					document.getElementById('createFolderModal').classList.remove('hidden');
				}

				// Close modal by ID
				window.closeModal = function(modalId) {
					document.getElementById(modalId).classList.add('hidden');
				}

				// Handle modal close buttons
				document.addEventListener('click', function(e) {
					if (e.target.hasAttribute('data-modal-close')) {
						const modalId = e.target.getAttribute('data-modal-close');
						closeModal(modalId);
					}
				});

				// Close modal when clicking outside
				window.onclick = function(event) {
					const modal = document.getElementById('createFolderModal');
					if (event.target === modal) {
						modal.classList.add('hidden');
					}
				}

				// Folder management functions
				window.editFolder = function(folderId) {
					console.log('Edit folder:', folderId);
					// TODO: Implement edit functionality
				}

				window.deleteFolder = function(folderId) {
					if (confirm('Are you sure you want to delete this folder?')) {
						console.log('Delete folder:', folderId);
						// TODO: Implement delete functionality
					}
				}
			});
		</script>
	}
}

// Create Folder Modal
templ CreateFolderModal() {
	@Modal("createFolderModal", "Create New Folder") {
		<form hx-post="/api/folders" hx-target="#folders-container" hx-swap="afterbegin">
			<div class="mb-4">
				<label for="name" class="block text-sm font-medium text-gray-700">Folder Name</label>
				<input
					type="text"
					id="name"
					name="name"
					required
					class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-gray-500 focus:border-gray-500"
					placeholder="Enter folder name"
				/>
			</div>
			<div class="mb-4">
				<label for="description" class="block text-sm font-medium text-gray-700">Description</label>
				<textarea
					id="description"
					name="description"
					rows="3"
					class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-gray-500 focus:border-gray-500"
					placeholder="Enter folder description (optional)"
				></textarea>
			</div>
			<div class="flex justify-end space-x-3">
				<button
					type="button"
					onclick="closeModal('createFolderModal')"
					class="px-4 py-2 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50"
				>
					Cancel
				</button>
				<button
					type="submit"
					class="px-4 py-2 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-gray-900 hover:bg-gray-800"
				>
					Create Folder
				</button>
			</div>
		</form>
	}
}
