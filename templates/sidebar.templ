package templates

import "mh-go/internal/models"

// Sidebar Navigation Component - Expandable with Alpine.js
templ Sidebar(currentPage string, user *models.User) {
	<div x-data="{
		open: false,
		expanded: false,
		toggleSidebar() { this.open = !this.open },
		closeSidebar() { this.open = false },
		expandSidebar() { this.expanded = true },
		collapseSidebar() { this.expanded = false }
	}" class="relative">
		<!-- Mobile Header Bar -->
		<div class="h-16 px-4 py-4 flex flex-row md:hidden items-center justify-between bg-neutral-100 dark:bg-neutral-800 w-full fixed top-0 left-0 right-0 z-40 border-b border-gray-200">
			<button @click="toggleSidebar()" class="text-neutral-800 dark:text-neutral-200 cursor-pointer p-2 hover:bg-gray-200 rounded-md">
				<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
				</svg>
			</button>
			<h1 class="text-lg font-semibold text-neutral-800 dark:text-neutral-200">
				if currentPage == "overview" || currentPage == "dashboard" {
					Overview
				} else if currentPage == "learning" {
					Learn
				} else if currentPage == "remember" {
					Remember
				} else if currentPage == "analyze" {
					Analyze
				} else if currentPage == "optimize" {
					Optimize
				} else if currentPage == "folders" {
					Folders
				} else if currentPage == "folder" {
					Folder
				} else if currentPage == "settings" {
					Settings
				} else {
					MH-Go
				}
			</h1>
		</div>

		<!-- Mobile Sidebar Overlay -->
		<div
			x-show="open"
			x-transition:enter="transition-opacity ease-linear duration-300"
			x-transition:enter-start="opacity-0"
			x-transition:enter-end="opacity-100"
			x-transition:leave="transition-opacity ease-linear duration-300"
			x-transition:leave-start="opacity-100"
			x-transition:leave-end="opacity-0"
			@click="closeSidebar()"
			class="fixed inset-0 bg-gray-600 bg-opacity-50 z-40 md:hidden"
			style="display: none;"
		></div>

		<!-- Mobile Sidebar -->
		<div
			x-show="open"
			x-transition:enter="transition ease-in-out duration-300 transform"
			x-transition:enter-start="-translate-x-full"
			x-transition:enter-end="translate-x-0"
			x-transition:leave="transition ease-in-out duration-300 transform"
			x-transition:leave-start="translate-x-0"
			x-transition:leave-end="-translate-x-full"
			class="fixed inset-y-0 left-0 w-80 bg-gray-50 z-50 md:hidden flex flex-col pt-16"
			style="display: none;"
		>
			<!-- Close Button -->
			<div class="absolute right-4 top-4 z-50">
				<button @click="closeSidebar()" class="text-gray-600 cursor-pointer p-2 hover:bg-gray-200 rounded-md">
					<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
					</svg>
				</button>
			</div>

			<!-- Mobile Navigation Links -->
			<nav class="flex-1 px-6 py-6">
				<ul class="space-y-2 text-left">
					<li>
						<a href="/dashboard" class={ getMobileSidebarLinkClass("overview", currentPage) } @click="closeSidebar()">
							<svg class="w-6 h-6 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
							</svg>
							<span class="text-sm font-medium">Overview</span>
						</a>
					</li>
					<li>
						<a href="/learning" class={ getMobileSidebarLinkClass("learning", currentPage) } @click="closeSidebar()">
							<svg class="w-6 h-6 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
							</svg>
							<span class="text-sm font-medium">Learn</span>
						</a>
					</li>
					<li>
						<a href="/remember" class={ getMobileSidebarLinkClass("remember", currentPage) } @click="closeSidebar()">
							<svg class="w-6 h-6 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path>
							</svg>
							<span class="text-sm font-medium">Remember</span>
						</a>
					</li>
					<li>
						<a href="/analyze" class={ getMobileSidebarLinkClass("analyze", currentPage) } @click="closeSidebar()">
							<svg class="w-6 h-6 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
							</svg>
							<span class="text-sm font-medium">Analyze</span>
						</a>
					</li>
					<li>
						<a href="/optimize" class={ getMobileSidebarLinkClass("optimize", currentPage) } @click="closeSidebar()">
							<svg class="w-6 h-6 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
							</svg>
							<span class="text-sm font-medium">Optimize</span>
						</a>
					</li>
					<li>
						<div class="border-t border-gray-300 my-4"></div>
					</li>
					<li>
						<a href="/folders" class={ getMobileSidebarLinkClass("folders", currentPage) } @click="closeSidebar()">
							<svg class="w-6 h-6 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2H5a2 2 0 00-2-2z"></path>
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 5a2 2 0 012-2h4a2 2 0 012 2v2H8V5z"></path>
							</svg>
							<span class="text-sm font-medium">Folders</span>
						</a>
					</li>
				</ul>
			</nav>
		</div>

		<!-- Desktop Sidebar -->
		<aside
			@mouseenter="expandSidebar()"
			@mouseleave="collapseSidebar()"
			:class="expanded ? 'w-72' : 'w-16'"
			class="hidden md:flex md:flex-col bg-gray-50 h-full flex-shrink-0 sidebar-transition fixed left-0 top-0 bottom-0 z-30 border-r border-gray-200"
		>
			<nav class="flex flex-1 flex-col px-3 py-6 bg-[#C5C4C4]">
				<ul class="space-y-2">
					<li>
						<a href="/overview" class={ getDesktopSidebarLinkClass("overview", currentPage) }>
							<div class="flex items-center justify-start gap-3 group/sidebar py-3 px-3 rounded-md transition-all duration-150 hover:bg-gray-200">
								<svg class="w-6 h-6 flex-shrink-0 text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
								</svg>
								<span
									x-show="expanded"
									x-transition:enter="transition-opacity duration-300 delay-150"
									x-transition:enter-start="opacity-0"
									x-transition:enter-end="opacity-100"
									x-transition:leave="transition-opacity duration-150"
									x-transition:leave-start="opacity-100"
									x-transition:leave-end="opacity-0"
									class="text-gray-700 text-base font-medium group-hover/sidebar:translate-x-1 transition duration-150 whitespace-nowrap"
								>
									Overview
								</span>
							</div>
						</a>
					</li>
					<li>
						<a href="/learning" class={ getDesktopSidebarLinkClass("learning", currentPage) }>
							<div class="flex items-center justify-start gap-3 group/sidebar py-3 px-3 rounded-md transition-all duration-150 hover:bg-gray-200">
								<svg class="w-6 h-6 flex-shrink-0 text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
								</svg>
								<span
									x-show="expanded"
									x-transition:enter="transition-opacity duration-300 delay-150"
									x-transition:enter-start="opacity-0"
									x-transition:enter-end="opacity-100"
									x-transition:leave="transition-opacity duration-150"
									x-transition:leave-start="opacity-100"
									x-transition:leave-end="opacity-0"
									class="text-gray-700 text-base font-medium group-hover/sidebar:translate-x-1 transition duration-150 whitespace-nowrap"
								>
									Learn
								</span>
							</div>
						</a>
					</li>
					<li>
						<a href="/remember" class={ getDesktopSidebarLinkClass("remember", currentPage) }>
							<div class="flex items-center justify-start gap-3 group/sidebar py-3 px-3 rounded-md transition-all duration-150 hover:bg-gray-200">
								<svg class="w-6 h-6 flex-shrink-0 text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path>
								</svg>
								<span
									x-show="expanded"
									x-transition:enter="transition-opacity duration-300 delay-150"
									x-transition:enter-start="opacity-0"
									x-transition:enter-end="opacity-100"
									x-transition:leave="transition-opacity duration-150"
									x-transition:leave-start="opacity-100"
									x-transition:leave-end="opacity-0"
									class="text-gray-700 text-base font-medium group-hover/sidebar:translate-x-1 transition duration-150 whitespace-nowrap"
								>
									Remember
								</span>
							</div>
						</a>
					</li>
					<li>
						<a href="/analyze" class={ getDesktopSidebarLinkClass("analyze", currentPage) }>
							<div class="flex items-center justify-start gap-3 group/sidebar py-3 px-3 rounded-md transition-all duration-150 hover:bg-gray-200">
								<svg class="w-6 h-6 flex-shrink-0 text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
								</svg>
								<span
									x-show="expanded"
									x-transition:enter="transition-opacity duration-300 delay-150"
									x-transition:enter-start="opacity-0"
									x-transition:enter-end="opacity-100"
									x-transition:leave="transition-opacity duration-150"
									x-transition:leave-start="opacity-100"
									x-transition:leave-end="opacity-0"
									class="text-gray-700 text-base font-medium group-hover/sidebar:translate-x-1 transition duration-150 whitespace-nowrap"
								>
									Analyze
								</span>
							</div>
						</a>
					</li>
					<li>
						<a href="/optimize" class={ getDesktopSidebarLinkClass("optimize", currentPage) }>
							<div class="flex items-center justify-start gap-3 group/sidebar py-3 px-3 rounded-md transition-all duration-150 hover:bg-gray-200">
								<svg class="w-6 h-6 flex-shrink-0 text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
								</svg>
								<span
									x-show="expanded"
									x-transition:enter="transition-opacity duration-300 delay-150"
									x-transition:enter-start="opacity-0"
									x-transition:enter-end="opacity-100"
									x-transition:leave="transition-opacity duration-150"
									x-transition:leave-start="opacity-100"
									x-transition:leave-end="opacity-0"
									class="text-gray-700 text-base font-medium group-hover/sidebar:translate-x-1 transition duration-150 whitespace-nowrap"
								>
									Optimize
								</span>
							</div>
						</a>
					</li>

					<!-- Separator for existing features -->
					<li>
						<div class="border-t border-gray-300 mt-4 pt-4">
							<span x-show="expanded" class="text-xs font-semibold text-gray-500 uppercase tracking-wider px-3">Storage</span>
						</div>
					</li>
					<li>
						<a href="/folders" class={ getDesktopSidebarLinkClass("folders", currentPage) }>
							<div class="flex items-center justify-start gap-3 group/sidebar py-3 px-3 rounded-md transition-all duration-150 hover:bg-gray-200">
								<svg class="w-6 h-6 flex-shrink-0 text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2H5a2 2 0 00-2-2z"></path>
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 5a2 2 0 012-2h4a2 2 0 012 2v2H8V5z"></path>
								</svg>
								<span
									x-show="expanded"
									x-transition:enter="transition-opacity duration-300 delay-150"
									x-transition:enter-start="opacity-0"
									x-transition:enter-end="opacity-100"
									x-transition:leave="transition-opacity duration-150"
									x-transition:leave-start="opacity-100"
									x-transition:leave-end="opacity-0"
									class="text-gray-700 text-base font-medium group-hover/sidebar:translate-x-1 transition duration-150 whitespace-nowrap"
								>
									Folders
								</span>
							</div>
						</a>
					</li>
					<li>
						<a href="/settings" class={ getDesktopSidebarLinkClass("settings", currentPage) }>
							<div class="flex items-center justify-start gap-3 group/sidebar py-3 px-3 rounded-md transition-all duration-150 hover:bg-gray-200">
								<svg class="w-6 h-6 flex-shrink-0 text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.50 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"></path>
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
								</svg>
								<span
									x-show="expanded"
									x-transition:enter="transition-opacity duration-300 delay-150"
									x-transition:enter-start="opacity-0"
									x-transition:enter-end="opacity-100"
									x-transition:leave="transition-opacity duration-150"
									x-transition:leave-start="opacity-100"
									x-transition:leave-end="opacity-0"
									class="text-gray-700 text-base font-medium group-hover/sidebar:translate-x-1 transition duration-150 whitespace-nowrap"
								>
									Settings
								</span>
							</div>
						</a>
					</li>
				</ul>

				<!-- User section at bottom -->
				if user != nil {
					<div class="mt-auto border-t border-gray-200 pt-4">
						<!-- User info -->
							<div class="flex items-center gap-3">
								<div class="w-8 h-8 bg-gray-300 rounded-full flex items-center justify-center flex-shrink-0">
									<svg class="w-4 h-4 text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
									</svg>
								</div>
								<div x-show="expanded" x-transition class="min-w-0 flex-1">
									<p class="text-sm font-medium text-gray-800 truncate">{ user.Email }</p>
								</div>
						</div>

						<!-- Sign out button -->
						<form hx-post="/logout" hx-redirect="/" class="px-2">
							<button type="submit" class="w-full flex items-center gap-3 py-2 text-sm rounded-md transition-colors mt-3">
								<svg class="w-6 h-6 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path>
								</svg>
								<span x-show="expanded" x-transition class="whitespace-nowrap text-gray-700">Sign out</span>
							</button>
						</form>
					</div>
				}
			</nav>
		</aside>
	</div>
}

// Helper function for mobile sidebar link classes
func getMobileSidebarLinkClass(page, currentPage string) string {
	baseClasses := "flex items-center gap-3 px-4 py-3 text-sm font-medium rounded-lg transition-colors w-full"
	if page == currentPage {
		return baseClasses + " bg-gray-100 text-gray-900"
	}
	return baseClasses + " text-gray-700 hover:text-gray-900 hover:bg-gray-100"
}

// Helper function for desktop sidebar link classes
func getDesktopSidebarLinkClass(page, currentPage string) string {
	baseClasses := "block w-full"
	if page == currentPage {
		return baseClasses + " text-gray-900"
	}
	return baseClasses + " text-gray-700"
}
